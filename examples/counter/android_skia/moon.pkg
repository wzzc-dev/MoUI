import {
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/moui/backend/android" @android_host,
  "wzzc-dev/moui/backend/android/skia" @android_skia_backend,
  "examples/counter/app" @counter_app,
}

supported_targets = "native"

options(
  "is-main": true,
  link: {
    "native": {
      "exports": [
        "android_counter_attach_surface",
        "android_counter_resize",
        "android_counter_dispatch_pointer",
        "android_counter_render_frame",
        "android_counter_detach_surface",
      ],
    },
  },
  targets: { "main.mbt": [ "native" ] },
)
