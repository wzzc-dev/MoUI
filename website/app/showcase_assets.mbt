///|
/// Generated by scripts/gen-website-showcase-assets.mjs.
/// Do not edit by hand. Base64-encoded downscaled screenshots
/// from resource/screenshots/*.png.
///|
fn showcase_thumbnail_data_uri(slug : String) -> String {
  match slug {
    "excel" => "data:image/png;base64,"
    "markdown_editor" => "data:image/png;base64,"
    "mo_workbench" => "data:image/png;base64,"
    "showcase" => "data:image/png;base64,"
    _ => ""
  }
}
