pub(all) struct UndoEntry {
  program : @ir.StudioProgram
  selected_control : String
  selected_handler : String
  code_draft : String
  coalesce_key : String
}

pub(all) struct WatchRow {
  name : String
  value : String
  type_label : String
}

pub(all) enum WorkSpace {
  WsVisual
  WsCode
  WsPreview
  WsEmpty
} derive(Eq)
pub fn WorkSpace::equal(Self, Self) -> Bool
pub fn WorkSpace::not_equal(Self, Self) -> Bool

// Type aliases
pub using @ai {type AiCard}

pub using @ai {type AiCardKind}

pub type BuildSubmit = (@build.BuildKind, String, String, (Result[@build.BuildReport, String]) -> Unit) -> Unit

pub type CompileSubmit = (String, String, (@export.CompileProgress) -> Unit, (Result[@export.CompileReport, String]) -> Unit) -> Unit

pub type LaunchSubmit = (String, (Result[Unit, String]) -> Unit) -> Unit

pub type PreviewWebControls = @kernel.PreviewWebControls[Msg]

pub using @ai {type ProposalRecord}

pub using @kernel {type ProviderRequestSpec}

pub type ProviderSubmit = (@kernel.ProviderRequestSpec, (Result[String, String]) -> Unit) -> Unit

pub type RuntimeSnapshotFn = () -> RuntimeInspectSample?

