name = "wzzc-dev/moui_terminal_host"

version = "0.2.0"

preferred_target = "native"

supported_targets = "native"

import {
  "wzzc-dev/moui@0.2.3",
  "wzzc-dev/moui_tui@0.1.0",
  "wzzc-dev/moui_tui_renderer@0.2.0",
}

repository = "https://github.com/wzzc-dev/MoUI.git"

license = "Apache-2.0"

keywords = [ "moui", "tui", "terminal", "raw-mode", "experimental" ]

description = "Experimental terminal host: raw-mode TTY input channels for the MoUI TUI renderer"
