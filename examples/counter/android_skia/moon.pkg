import {
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/moui/backend/android" @android_host,
  "wzzc-dev/moui/backend/android/skia" @android_skia_backend,
  "wzzc-dev/moui/render",
  "examples/counter/app" @counter_app,
}

supported_targets = "native"

options(
  "is-main": true,
  link: {
    "native": {
      "exports": [
        "moui_mobile_take_host_updates_json",
        "moui_mobile_renderer_configure",
        "moui_mobile_renderer_status_json",
        "moui_mobile_dispatch_text_input",
        "moui_mobile_dispatch_command",
        "moui_mobile_dispatch_accessibility",
        "moui_mobile_complete_clipboard",
        "android_counter_attach_surface",
        "android_counter_resize",
        "android_counter_dispatch_pointer",
        "android_counter_frame_tick",
        "android_counter_render_frame",
        "android_counter_detach_surface",
      ],
    },
  },
  targets: { "main.mbt": [ "native" ] },
)
