import {
  "moonbitlang/core/encoding/utf8",
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/render/wgpu" @wgpu_renderer,
  "wzzc-dev/moui/render/wgpu/text_protocol",
}

supported_targets = "native"

options(
  link: {
    "native": {
      // Host-specific include/link flags come from moui/build.js prebuild
      // link_configs on Linux. Off-Linux hosts compile the no-op stub path.
      "stub-cc-flags": "",
      "cc-link-flags": "",
    },
  },
  "native-stub": [ "linux_fontconfig_text.c" ],
  targets: { },
)
