///| Generated by scripts/generate-grapheme-break-fixtures.mjs.

///| Source fixture: moui/core/unicode/testdata/grapheme_break_samples.txt

///|
fn assert_generated_grapheme_break_fixture(
  text : String,
  expected : Array[Int],
  label : String,
) -> Unit raise {
  let actual = TextGraphemeBoundaries::new(text~).boundaries()
  if actual.length() != expected.length() {
    fail(
      "\{label}: expected \{expected.length()} grapheme boundaries, got \{actual.length()}",
    )
  }
  for index in 0..<expected.length() {
    inspect(actual[index], content="\{expected[index]}")
  }
}

///|
test "generated grapheme break fixture samples" {
  assert_generated_grapheme_break_fixture(
    "\u{D}\u{A}\u{41}",
    [0, 2, 3],
    "GB3 CR x LF",
  )
  assert_generated_grapheme_break_fixture(
    "\u{41}\u{7}\u{301}\u{42}",
    [0, 1, 2, 3, 4],
    "GB4/GB5 controls break before Extend",
  )
  assert_generated_grapheme_break_fixture(
    "\u{600}\u{41}",
    [0, 2],
    "GB9b Prepend x Any",
  )
  assert_generated_grapheme_break_fixture(
    "\u{D4E}\u{D15}",
    [0, 2],
    "Unicode 17 GCB Prepend Malayalam dot reph",
  )
  assert_generated_grapheme_break_fixture(
    "\u{41}\u{13430}\u{301}\u{42}",
    [0, 1, 2, 3, 4],
    "Unicode 17 GCB Control high-plane format",
  )
  assert_generated_grapheme_break_fixture(
    "\u{41}\u{308}\u{301}\u{42}",
    [0, 3, 4],
    "GB9 Extend chain",
  )
  assert_generated_grapheme_break_fixture(
    "\u{41}\u{483}\u{42}",
    [0, 2, 3],
    "Unicode 17 GCB Extend Cyrillic titlo",
  )
  assert_generated_grapheme_break_fixture(
    "\u{41}\u{915}\u{93E}\u{42}",
    [0, 1, 3, 4],
    "GB9a SpacingMark",
  )
  assert_generated_grapheme_break_fixture(
    "\u{A95}\u{A83}\u{41}",
    [0, 2, 3],
    "Unicode 17 GCB SpacingMark Gujarati visarga",
  )
  assert_generated_grapheme_break_fixture(
    "\u{41}\u{1D165}\u{42}",
    [0, 2, 3],
    "GB9 supplementary musical Extend",
  )
  assert_generated_grapheme_break_fixture(
    "\u{1100}\u{1161}\u{11A8}",
    [0, 3],
    "GB6/GB7/GB8 Hangul LVT sequence",
  )
  assert_generated_grapheme_break_fixture(
    "\u{1F1FA}\u{1F1F8}\u{1F1E8}\u{1F1E6}",
    [0, 2, 4],
    "GB12/GB13 RI pairs",
  )
  assert_generated_grapheme_break_fixture(
    "\u{1F468}\u{1F3FE}\u{200D}\u{1F680}",
    [0, 4],
    "GB11 emoji modifier ZWJ sequence",
  )
  assert_generated_grapheme_break_fixture(
    "\u{1F468}\u{200D}\u{41}",
    [0, 2, 3],
    "GB11 rejects ZWJ before non-ExtPict",
  )
  assert_generated_grapheme_break_fixture(
    "\u{1FC00}\u{200D}\u{1FC01}",
    [0, 3],
    "Unicode 17 Extended_Pictographic ZWJ sequence",
  )
  assert_generated_grapheme_break_fixture(
    "\u{2615}\u{FE0F}\u{41}",
    [0, 2, 3],
    "GB9 variation selector emoji presentation",
  )
  assert_generated_grapheme_break_fixture(
    "\u{31}\u{FE0F}\u{20E3}",
    [0, 3],
    "GB9 keycap sequence",
  )
  assert_generated_grapheme_break_fixture(
    "\u{1F3F4}\u{E0067}\u{E0062}\u{E007F}",
