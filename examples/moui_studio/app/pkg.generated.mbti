// Types and methods
pub(all) enum AiAnchor {
  AiBar
  AiDocked
}

pub(all) struct AiCard {
  kind : AiCardKind
  title : String
  body : String
  steps : Array[String]
  steps_done : Int
  progress : Int
  diff_lines : Array[(String, String)]
  settled : Bool
  settled_note : String
  seq : Int
}

pub(all) enum AiCardKind {
  CardPlan
  CardDiff
  CardSideEffect
  CardExplanation
  CardError
}

pub(all) enum ArtifactAction {
  ArtifactCopy
  ArtifactReveal
  ArtifactLaunch
}

pub(all) struct AuditEntry {
  kind : AuditKind
  seq : Int
  text : String
  detail : String
  stack : String
  settled : Bool
  settled_note : String
}

pub(all) enum AuditKind {
  AuditOk
  AuditRun
  AuditWarn
  AuditError
}

pub(all) struct BlockCategoryEntry {
  category : @blocks.BlockCategory
  first_index : Int
}

pub(all) struct BlocksDragState {
  list_path : Array[Int]
  from_path : Array[Int]
  from : Int
  to : Int
  to_list : Array[Int]
  valid : Bool
}

pub(all) enum BlocksDrawOp {
  BlockBody(Double, Double, Double, Double, @blocks.BlockKind)
  BlockArm(Double, Double, Double, Double, @blocks.BlockKind)
  BlockBadge(Double, Double, @blocks.BlockKind)
  BlockTab(Double, Double, Double, @blocks.BlockKind)
  BlockNotchCut(Double, Double)
  BlockLabel(String, Double, Double, Double, String)
  ScriptNote(String, Double, Double, Double)
  BlockStroke(Double, Double, Double, Double)
  InsertMark(Double, Double, Double, Bool)
  SlotHole(Double, Double, Double, Double, Bool)
}

pub(all) enum BottomTab {
  BtAudit
  BtConsole
  BtProblems
  BtAi
}

pub(all) enum ChipTone {
  Quiet
  Primary
  Ghost
}

pub(all) struct CodeLine {
  number : Int
  tokens : Array[CodeToken]
}

pub(all) struct CodeToken {
  kind : CodeTokenKind
  text : String
}

pub(all) enum CodeTokenKind {
  TokKeyword
  TokString
  TokNumber
  TokBuiltin
  TokComment
  TokPlain
}

pub(all) struct CompiledRun {
  handler_label : String
  runtime : @compiled_runtime.Runtime
