import {
  "moonbitlang/core/encoding/utf8",
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/moui/backend/macos" @macos_host,
  "wzzc-dev/moui/render",
  "wzzc-dev/moui/render/sun" @sun_renderer,
  "wzzc-dev/moui_sun/softbuffer" @sun_softbuffer,
  "wzzc-dev/window/core" @window_core,
  "wzzc-dev/window/dpi",
  "wzzc-dev/window/macos" @window_macos,
}

import {
  "moonbitlang/x/fs",
  "wzzc-dev/moui/core",
} for "wbtest"

supported_targets = "native"

options(
  link: {
    "native": {
      "cc-link-flags": "-framework AppKit -framework QuartzCore -framework UniformTypeIdentifiers -framework WebKit -framework CoreGraphics -framework CoreFoundation -lobjc -lz",
    },
  },
  "native-stub": [ "macos_sun_async_image.m" ],
  targets: { },
)
