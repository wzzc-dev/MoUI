{
  "schemaVersion": 1,
  "description": "Checked-in MoUI smoke gate catalog. This is source metadata, not generated smoke evidence.",
  "tiers": ["daily", "nightly", "release"],
  "suites": [
    {
      "id": "daily.check",
      "tier": "daily",
      "kind": "package-baseline",
      "host": "any",
      "purpose": "Keep the default development gate bounded to package checks, static guards, and Web wasm-gc builds.",
      "defaultDevCheck": true,
      "commands": [
        {
          "argv": ["sh", "scripts/check.sh", "--profile", "daily"],
          "mode": "run"
        }
      ],
      "result": {
        "type": "exit-code"
      },
      "ci": {
        "workflow": ".github/workflows/ci.yml",
        "gate": "pull_request"
      },
      "docs": ["docs/testing.md", "docs/release-readiness.md"],
      "artifacts": []
    },
    {
      "id": "web.runtime-presentation",
      "tier": "nightly",
      "kind": "browser-runtime-smoke",
      "host": "macos-14",
      "purpose": "Record and validate a real browser WebGPU/wasm/canvas/input/pixel presentation session.",
      "defaultDevCheck": false,
      "commands": [
        {
          "argv": ["sh", "scripts/ci-web-runtime-presentation.sh"],
          "mode": "run"
        }
      ],
      "result": {
        "type": "manifest",
        "path": "artifacts/smoke/web-runtime-presentation/presentation-smoke.json",
        "validator": [
          "node",
          "scripts/validate-web-runtime-presentation-manifest.mjs",
          "artifacts/smoke/web-runtime-presentation/presentation-smoke.json",
          "--require-passed"
        ]
      },
      "ci": {
        "workflow": ".github/workflows/moui-runtime-gates.yml",
        "gate": "nightly"
      },
      "docs": ["docs/testing.md", "docs/release-readiness.md"],
      "artifacts": [
        "artifacts/smoke/web-runtime-presentation/presentation-smoke.json",
        "artifacts/smoke/web-runtime-presentation/http-server.log",
        "artifacts/smoke/web-runtime-presentation/chrome.log"
      ]
    },
    {
      "id": "macos.skia-real-showcase-markdown",
      "tier": "release",
      "kind": "native-real-renderer-smoke",
      "host": "macos-14",
      "purpose": "Prove real Skia renderer pixels plus tester-owned Showcase and Markdown Editor first-frame presentation on the matching host.",
      "defaultDevCheck": false,
      "commands": [
        {
          "argv": [
            "sh",
            "scripts/macos-skia-renderer-smoke.sh",
            "--run-showcase-smoke",
            "--run-markdown-smoke",
            "--smoke-log",
            "artifacts/platform-observation/macos/skia-renderer-smoke.log",
            "--showcase-log",
            "artifacts/platform-observation/macos/showcase-macos-skia-first-frame.log",
            "--markdown-log",
            "artifacts/example-smoke/macos/markdown-macos-skia-first-frame.log"
          ],
          "mode": "run"
        }
      ],
      "result": {
        "type": "log-marker",
        "markers": [
          "MoUI Skia renderer smoke passed",
          "MoUI Skia async image second-frame smoke passed",
          "Verified moui_tester first-frame smoke marker.",
          "MoUI macOS Skia renderer smoke passed."
        ]
      },
      "ci": {
        "workflow": ".github/workflows/moui-runtime-gates.yml",
        "gate": "release-manual"
      },
      "docs": ["docs/testing.md", "docs/release-readiness.md"],
      "artifacts": [
        "artifacts/platform-observation/macos/skia-renderer-smoke.log",
        "artifacts/platform-observation/macos/showcase-macos-skia-first-frame.log",
        "artifacts/example-smoke/macos/markdown-macos-skia-first-frame.log"
      ]
    },
    {
      "id": "window-package.matching-host",
      "tier": "release",
      "kind": "dependency-matching-host-smoke",
      "host": "matching-host",
      "purpose": "Run the resolved window package MoUI helper on the host being claimed without reintroducing an editable window checkout.",
      "defaultDevCheck": false,
      "commands": [
        {
          "argv": ["scripts/run-window-package-smoke.sh", "<macos|web|windows|linux>", "--run"],
          "mode": "manual"
        }
      ],
      "result": {
        "type": "exit-code"
      },
      "ci": {
        "workflow": ".github/workflows/moui-runtime-gates.yml",
        "gate": "release-manual"
      },
      "docs": ["docs/testing.md", "docs/release-readiness.md"],
      "artifacts": ["artifacts/window-package-smoke/<platform>.log"]
    },
    {
      "id": "android.counter-runtime",
      "tier": "release",
      "kind": "shell-runtime-smoke",
      "host": "android-device-or-emulator",
      "purpose": "Record non-fallback Counter Android Activity, ANativeWindow, first-frame, input, resize, and shutdown evidence.",
      "defaultDevCheck": false,
      "commands": [
        {
          "argv": ["node", "scripts/record-shell-runtime-smoke.mjs", "--platform", "android", "--app", "counter", "--manifest", "artifacts/shell-runtime/android/counter/shell-runtime-smoke.json", "--require-passed"],
          "mode": "manual"
        }
      ],
      "result": {
        "type": "manifest",
        "path": "artifacts/shell-runtime/android/counter/shell-runtime-smoke.json",
        "validator": ["node", "scripts/validate-shell-runtime-manifest.mjs", "artifacts/shell-runtime/android/counter/shell-runtime-smoke.json", "--require-passed"]
      },
      "ci": {
        "workflow": ".github/workflows/moui-runtime-gates.yml",
        "gate": "release-manual"
      },
      "docs": ["docs/android-support.md", "docs/testing.md", "docs/release-readiness.md"],
      "artifacts": [
        "artifacts/shell-runtime/android/counter/shell-runtime-smoke.json",
        "artifacts/shell-runtime/android/counter/screenshot-before.png",
        "artifacts/shell-runtime/android/counter/screenshot.png",
        "artifacts/shell-runtime/android/counter/runtime.log"
      ]
    },
    {
      "id": "ios.counter-runtime",
      "tier": "release",
      "kind": "shell-runtime-smoke",
      "host": "macos-ios-simulator",
      "purpose": "Record non-fallback Counter iOS Simulator UIKit, UIView, first-frame, touch, resize, and shutdown evidence.",
      "defaultDevCheck": false,
      "commands": [
        {
          "argv": ["node", "scripts/record-shell-runtime-smoke.mjs", "--platform", "ios", "--app", "counter", "--manifest", "artifacts/shell-runtime/ios/counter/shell-runtime-smoke.json", "--require-passed"],
          "mode": "manual"
        }
      ],
      "result": {
        "type": "manifest",
        "path": "artifacts/shell-runtime/ios/counter/shell-runtime-smoke.json",
        "validator": ["node", "scripts/validate-shell-runtime-manifest.mjs", "artifacts/shell-runtime/ios/counter/shell-runtime-smoke.json", "--require-passed"]
      },
      "ci": {
        "workflow": ".github/workflows/moui-runtime-gates.yml",
        "gate": "release-manual"
      },
      "docs": ["docs/ios-support.md", "docs/testing.md", "docs/release-readiness.md"],
      "artifacts": [
        "artifacts/shell-runtime/ios/counter/shell-runtime-smoke.json",
        "artifacts/shell-runtime/ios/counter/screenshot-before.png",
        "artifacts/shell-runtime/ios/counter/screenshot.png",
        "artifacts/shell-runtime/ios/counter/runtime.log"
      ]
    },
    {
      "id": "android.showcase-runtime",
      "tier": "release",
      "kind": "shell-runtime-smoke",
      "host": "android-device-or-emulator",
      "purpose": "Record non-fallback MoUI Showcase Android runtime evidence including scroll input.",
      "defaultDevCheck": false,
      "commands": [
        {
          "argv": ["node", "scripts/record-shell-runtime-smoke.mjs", "--platform", "android", "--app", "showcase", "--manifest", "artifacts/shell-runtime/android/showcase/shell-runtime-smoke.json", "--require-passed"],
          "mode": "manual"
        }
      ],
      "result": {
        "type": "manifest",
        "path": "artifacts/shell-runtime/android/showcase/shell-runtime-smoke.json",
        "validator": ["node", "scripts/validate-shell-runtime-manifest.mjs", "artifacts/shell-runtime/android/showcase/shell-runtime-smoke.json", "--require-passed"]
      },
      "ci": {
        "workflow": ".github/workflows/moui-runtime-gates.yml",
        "gate": "release-manual"
      },
      "docs": ["docs/android-support.md", "docs/testing.md", "docs/release-readiness.md"],
      "artifacts": [
        "artifacts/shell-runtime/android/showcase/shell-runtime-smoke.json",
        "artifacts/shell-runtime/android/showcase/screenshot-before.png",
        "artifacts/shell-runtime/android/showcase/screenshot.png",
        "artifacts/shell-runtime/android/showcase/runtime.log"
      ]
    },
    {
      "id": "ios.showcase-runtime",
      "tier": "release",
      "kind": "shell-runtime-smoke",
      "host": "macos-ios-simulator",
      "purpose": "Record non-fallback MoUI Showcase iOS Simulator runtime evidence including scroll input.",
      "defaultDevCheck": false,
      "commands": [
        {
          "argv": ["node", "scripts/record-shell-runtime-smoke.mjs", "--platform", "ios", "--app", "showcase", "--manifest", "artifacts/shell-runtime/ios/showcase/shell-runtime-smoke.json", "--require-passed"],
          "mode": "manual"
        }
      ],
      "result": {
        "type": "manifest",
        "path": "artifacts/shell-runtime/ios/showcase/shell-runtime-smoke.json",
        "validator": ["node", "scripts/validate-shell-runtime-manifest.mjs", "artifacts/shell-runtime/ios/showcase/shell-runtime-smoke.json", "--require-passed"]
      },
      "ci": {
        "workflow": ".github/workflows/moui-runtime-gates.yml",
        "gate": "release-manual"
      },
      "docs": ["docs/ios-support.md", "docs/testing.md", "docs/release-readiness.md"],
      "artifacts": [
        "artifacts/shell-runtime/ios/showcase/shell-runtime-smoke.json",
        "artifacts/shell-runtime/ios/showcase/screenshot-before.png",
        "artifacts/shell-runtime/ios/showcase/screenshot.png",
        "artifacts/shell-runtime/ios/showcase/runtime.log"
      ]
    },
    {
      "id": "harmonyos.demo-runtime",
      "tier": "release",
      "kind": "shell-runtime-smoke",
      "host": "harmonyos-device-or-emulator",
      "purpose": "Record non-fallback HarmonyOS demo Stage Ability/XComponent first-frame, single-touch, lifecycle, and platform-service evidence.",
      "defaultDevCheck": false,
      "commands": [
        {
          "argv": ["node", "scripts/record-shell-runtime-smoke.mjs", "--platform", "harmonyos", "--app", "harmonyos_demo", "--manifest", "artifacts/shell-runtime/harmonyos/harmonyos_demo/shell-runtime-smoke.json", "--require-passed"],
          "mode": "manual"
        }
      ],
      "result": {
        "type": "manifest",
        "path": "artifacts/shell-runtime/harmonyos/harmonyos_demo/shell-runtime-smoke.json",
        "validator": ["node", "scripts/validate-shell-runtime-manifest.mjs", "artifacts/shell-runtime/harmonyos/harmonyos_demo/shell-runtime-smoke.json", "--require-passed"]
      },
      "ci": {
        "workflow": ".github/workflows/moui-runtime-gates.yml",
        "gate": "release-manual"
      },
      "docs": ["docs/harmonyos-support.md", "docs/testing.md", "docs/release-readiness.md"],
      "artifacts": [
        "artifacts/shell-runtime/harmonyos/harmonyos_demo/shell-runtime-smoke.json",
        "artifacts/shell-runtime/harmonyos/harmonyos_demo/screenshot-before.png",
        "artifacts/shell-runtime/harmonyos/harmonyos_demo/screenshot.png",
        "artifacts/shell-runtime/harmonyos/harmonyos_demo/runtime.log"
      ]
    },
    {
      "id": "harmonyos.showcase-runtime",
      "tier": "release",
      "kind": "shell-runtime-smoke",
      "host": "harmonyos-device-or-emulator",
      "purpose": "Record non-fallback MoUI Showcase HarmonyOS input, scroll, lifecycle, and platform-service evidence.",
      "defaultDevCheck": false,
      "commands": [
        {
          "argv": ["node", "scripts/record-shell-runtime-smoke.mjs", "--platform", "harmonyos", "--app", "showcase", "--manifest", "artifacts/shell-runtime/harmonyos/showcase/shell-runtime-smoke.json", "--require-passed"],
          "mode": "manual"
        }
      ],
      "result": {
        "type": "manifest",
        "path": "artifacts/shell-runtime/harmonyos/showcase/shell-runtime-smoke.json",
        "validator": ["node", "scripts/validate-shell-runtime-manifest.mjs", "artifacts/shell-runtime/harmonyos/showcase/shell-runtime-smoke.json", "--require-passed"]
      },
      "ci": {
        "workflow": ".github/workflows/moui-runtime-gates.yml",
        "gate": "release-manual"
      },
      "docs": ["docs/harmonyos-support.md", "docs/testing.md", "docs/release-readiness.md"],
      "artifacts": [
        "artifacts/shell-runtime/harmonyos/showcase/shell-runtime-smoke.json",
        "artifacts/shell-runtime/harmonyos/showcase/screenshot-before.png",
        "artifacts/shell-runtime/harmonyos/showcase/screenshot.png",
        "artifacts/shell-runtime/harmonyos/showcase/runtime.log"
      ]
    }
  ]
}
