import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/fs",
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/render",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/window/core" @window_core,
  "wzzc-dev/window/dpi",
  "wzzc-dev/window/linux" @window_linux,
}

import {
  "wzzc-dev/moui/views",
} for "test"

import {
  "wzzc-dev/moui/views",
} for "wbtest"

supported_targets = "native"

options(
  link: {
    "native": {
      "stub-cc-flags": "${build.MOUI_LINUX_GLIB_STUB_CC_FLAGS}",
      "cc-link-flags": "-lz ${build.MOUI_LINUX_GLIB_CC_LINK_FLAGS}",
    },
  },
  "native-stub": [ "linux_service_host.c", "linux_timer_host.c" ],
  targets: { },
)
