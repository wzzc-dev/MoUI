import {
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/services",
  "wzzc-dev/moui/backend" @host,
  "wzzc-dev/moui/backend/common/embedded" @embedded_runtime,
  "wzzc-dev/moui/render",
  "wzzc-dev/window/core" @window_core,
  "wzzc-dev/window/android" @window_android,
}

import {
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/views",
} for "test"

import {
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/views",
} for "wbtest"

supported_targets = "native"

options(
  link: {
    "native": { "cc-link-flags": "${build.MOUI_ANDROID_HOST_LINK_FLAGS}" },
  },
  "native-stub": [ "android_present.cpp" ],
  targets: { },
)
