import {
  "wzzc-dev/moui/apphost",
  "wzzc-dev/moui/backend/macos",
  "wzzc-dev/moui_skia_renderer" @render_skia,
  "wzzc-dev/moui/runtime",
  "examples/p5_sketch/app" @p5_app,
  "examples/p5_sketch/p5",
  "examples/p5_sketch/p5/http" @p5_http,
  "examples/p5_sketch/skia_raster" @p5_skia_raster,
  "moonbitlang/async",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "" } },
  targets: { "main.mbt": [ "native" ] },
)
