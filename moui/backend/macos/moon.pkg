import {
  "moonbitlang/async",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/fs",
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/window/core" @window_core,
  "wzzc-dev/window/dpi",
  "wzzc-dev/window/macos" @window_macos,
}

import {
  "wzzc-dev/moui/views",
} for "test"

import {
  "wzzc-dev/moui/views",
} for "wbtest"

supported_targets = "native"

options(
  link: {
    "native": {
      "cc-link-flags": "-framework AppKit -framework QuartzCore -framework UniformTypeIdentifiers -lz",
    },
  },
  "native-stub": [
    "macos_service_host.m",
    "macos_timer_host.m",
    "macos_perf_clock.c",
  ],
  targets: { },
)
