import {
  "moonbitlang/core/encoding/utf8",
  "examples/pdf_workbench/app",
}

import {
  "examples/pdf_workbench/pdflite_adapter",
} for "wbtest"

supported_targets = "native"

options(
  "native-stub": [ "pdfium_stub.c" ],
  link: {
    "native": {
      "stub-cc-flags": "${build.MOUI_PDFIUM_STUB_CC_FLAGS}",
      "cc-link-flags": "${build.MOUI_PDFIUM_CC_LINK_FLAGS}",
    },
  },
  targets: { "adapter.mbt": [ "native" ], "adapter_wbtest.mbt": [ "native" ] },
)
