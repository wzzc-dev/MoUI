///|
/// Scenario: a playable AI world as plain data.
///
/// A scenario is a *background* (tavern, city, cultivation estate, imperial
/// court, jianghu) plus the characters who inhabit it and the world book that
/// feeds background lore into the prompt. Everything here is plain data with a
/// hand-written JSON codec in `scenario_codec.mbt`: adding a background means
/// adding a JSON file, not writing code.
///
/// The character card shape follows the SillyTavern card convention closely
/// enough that an exported card can be pasted in: persona, appearance, secret,
/// goal, and voice are the fields that actually change what a model writes.

///|
/// One place in the scene. Rects are in scenario-map logical pixels.
pub struct ScenarioLocation {
  id : String
  name : String
  /// What the model is told about this place.
  description : String
  rect : @geometry.Rect
} derive(Eq, Debug)

///|
pub extend ScenarioLocation with Debug::{to_repr}

///|
pub extend ScenarioLocation with Eq::{not_equal, equal}

///|
pub fn ScenarioLocation::new(
  id~ : String,
  name~ : String,
  description~ : String,
  rect~ : @geometry.Rect,
) -> ScenarioLocation {
  { id, name, description, rect, }
}

///|
pub fn ScenarioLocation::id(self : ScenarioLocation) -> String {
  self.id
}

///|
pub fn ScenarioLocation::name(self : ScenarioLocation) -> String {
  self.name
}

///|
pub fn ScenarioLocation::description(self : ScenarioLocation) -> String {
  self.description
}

///|
pub fn ScenarioLocation::rect(self : ScenarioLocation) -> @geometry.Rect {
  self.rect
}

///|
/// One character card.
pub struct CharacterCard {
  id : String
  name : String
  /// Who they are: drives tone, vocabulary, and behaviour.
  persona : String
  /// How they look, in prose (feeds the model and a future image prompt).
  appearance : String
  /// Portrait file name, relative to the world folder (e.g. `林掌柜.png`).
  /// Empty means "no portrait": the UI falls back to the colour block derived
  /// from the name. The image bytes are NOT stored in the card — the card is
  /// Markdown and stays readable, and a portrait is one file beside it.
  portrait : String
  /// A ready-to-paste prompt for an image model, when a world was generated by
  /// AI. The app never calls an image API: this text exists so the player can
  /// take it to whatever tool they like and drop the resulting PNG into
  /// `characters/`. Empty for hand-written cards.
  portrait_prompt : String
  /// What they will not volunteer; a good reason for the player to ask twice.
  secret : String
  /// What they want right now.
  goal : String
  /// How they talk: speech pattern, verbal tics, register.
  voice : String
  /// Where they stand on the map.
  location : String
  point : @geometry.Point
  /// Colour used for their map marker.
  color : @graphics.Color
} derive(Eq, Debug)

///|
pub extend CharacterCard with Debug::{to_repr}

///|
pub extend CharacterCard with Eq::{not_equal, equal}

///|
pub fn CharacterCard::new(
  id~ : String,
  name~ : String,
  persona~ : String,
  appearance? : String,
  portrait? : String,
  portrait_prompt? : String,
  secret? : String,
  goal? : String,
  voice? : String,
  location? : String,
  point? : @geometry.Point,
  color? : @graphics.Color,
) -> CharacterCard {
  {
    id,
    name,
    persona,
    appearance: appearance.unwrap_or(""),
    portrait: portrait.unwrap_or(""),
    portrait_prompt: portrait_prompt.unwrap_or(""),
    secret: secret.unwrap_or(""),
    goal: goal.unwrap_or(""),
    voice: voice.unwrap_or(""),
    location: location.unwrap_or(""),
    point: point.unwrap_or(@geometry.Point::new(x=0.0, y=0.0)),
    color: color.unwrap_or(@graphics.Color::rgba(r=0.78, g=0.62, b=0.36)),
  }
}

///|
pub fn CharacterCard::id(self : CharacterCard) -> String {
  self.id
}

///|
pub fn CharacterCard::name(self : CharacterCard) -> String {
  self.name
}

///|
pub fn CharacterCard::persona(self : CharacterCard) -> String {
  self.persona
}

///|
pub fn CharacterCard::appearance(self : CharacterCard) -> String {
  self.appearance
}

///|
pub fn CharacterCard::portrait_prompt(self : CharacterCard) -> String {
  self.portrait_prompt
}

///|
pub fn CharacterCard::portrait(self : CharacterCard) -> String {
  self.portrait
}

///|
pub fn CharacterCard::secret(self : CharacterCard) -> String {
  self.secret
}

///|
pub fn CharacterCard::goal(self : CharacterCard) -> String {
  self.goal
}

///|
pub fn CharacterCard::voice(self : CharacterCard) -> String {
  self.voice
}

///|
pub fn CharacterCard::location(self : CharacterCard) -> String {
  self.location
}

///|
pub fn CharacterCard::point(self : CharacterCard) -> @geometry.Point {
  self.point
}

///|
pub fn CharacterCard::color(self : CharacterCard) -> @graphics.Color {
  self.color
}

///|
/// One world-book entry: when any of its keys appears in the conversation, its
/// content is injected into the prompt. This is the SillyTavern "world info"
/// mechanism, and it is how a scenario stays small while still reacting to what
/// the player actually says.
pub struct WorldEntry {
  /// Trigger keywords, matched case-insensitively as substrings.
  keys : Array[String]
  content : String
  /// Higher priority entries are injected first and survive budget trimming
  /// longer. SillyTavern's lorebook has the same knob; without it a long
  /// conversation can push the one fact that matters out of the prompt.
  priority : Int32
  /// Where in the request the entry belongs. `Before` rides at the top of the
  /// system prompt (world rules), `After` sits just before the history (scene
  /// facts). Placement is what makes lore feel like setting rather than an
  /// interruption.
  position : LorePosition
  /// Re-scan the injected text for further triggers (`depth` = how many extra
  /// rounds). A single pass misses chains like "当铺" → "周掌柜" → "官文".
  recursion : Int32
  /// Percentage chance (0-100) an entry is injected when it matches. 100 is
  /// always. Below 100 lets a world keep a fact occasional so it stays fresh;
  /// the roll is deterministic per (entry, turn) so a retry is reproducible.
  probability : Int32
} derive(Eq, Debug)

///|
pub(all) enum LorePosition {
  /// Top of the system prompt, before the persona (world rules).
  Before
  /// Just before the conversation history (scene facts).
  After
} derive(Eq, Debug)

///|
pub extend LorePosition with Debug::{to_repr}

///|
pub extend LorePosition with Eq::{not_equal, equal}

///|
pub extend WorldEntry with Debug::{to_repr}

///|
pub extend WorldEntry with Eq::{not_equal, equal}

///|
pub fn WorldEntry::new(
  keys~ : Array[String],
  content~ : String,
  priority? : Int32,
  position? : LorePosition,
  recursion? : Int32,
  probability? : Int32,
) -> WorldEntry {
  {
    keys,
    content,
    priority: priority.unwrap_or(0),
    position: position.unwrap_or(After),
    recursion: recursion.unwrap_or(0),
    probability: probability.unwrap_or(100),
  }
}

///|
pub fn WorldEntry::priority(self : WorldEntry) -> Int32 {
  self.priority
}

///|
pub fn WorldEntry::position(self : WorldEntry) -> LorePosition {
  self.position
}

///|
pub fn WorldEntry::recursion(self : WorldEntry) -> Int32 {
  self.recursion
}

///|
pub fn WorldEntry::probability(self : WorldEntry) -> Int32 {
  self.probability
}

///|
pub fn WorldEntry::keys(self : WorldEntry) -> Array[String] {
  self.keys
}

///|
pub fn WorldEntry::content(self : WorldEntry) -> String {
  self.content
}

///|
/// A whole world.
pub struct Scenario {
  id : String
  name : String
  /// The world's shared background, always included in the system prompt.
  background : String
  /// Map size in logical pixels.
  map_width : Double
  map_height : Double
  locations : Array[ScenarioLocation]
  characters : Array[CharacterCard]
  world_book : Array[WorldEntry]
} derive(Eq, Debug)

///|
pub extend Scenario with Debug::{to_repr}

///|
pub extend Scenario with Eq::{not_equal, equal}

///|
pub fn Scenario::new(
  id~ : String,
  name~ : String,
  background~ : String,
  map_width? : Double,
  map_height? : Double,
  locations? : Array[ScenarioLocation],
  characters? : Array[CharacterCard],
  world_book? : Array[WorldEntry],
) -> Scenario {
  {
    id,
    name,
    background,
    map_width: map_width.unwrap_or(640.0),
    map_height: map_height.unwrap_or(420.0),
    locations: locations.unwrap_or([]),
    characters: characters.unwrap_or([]),
    world_book: world_book.unwrap_or([]),
  }
}

///|
pub fn Scenario::id(self : Scenario) -> String {
  self.id
}

///|
pub fn Scenario::name(self : Scenario) -> String {
  self.name
}

///|
pub fn Scenario::background(self : Scenario) -> String {
  self.background
}

///|
pub fn Scenario::map_width(self : Scenario) -> Double {
  self.map_width
}

///|
pub fn Scenario::map_height(self : Scenario) -> Double {
  self.map_height
}

///|
pub fn Scenario::locations(self : Scenario) -> Array[ScenarioLocation] {
  self.locations
}

///|
pub fn Scenario::characters(self : Scenario) -> Array[CharacterCard] {
  self.characters
}

///|
pub fn Scenario::world_book(self : Scenario) -> Array[WorldEntry] {
  self.world_book
}

///|
pub fn Scenario::character(self : Scenario, id : String) -> CharacterCard? {
  for card in self.characters {
    if card.id == id {
      return Some(card)
    }
  }
  None
}

///|
pub fn Scenario::location(self : Scenario, id : String) -> ScenarioLocation? {
  for place in self.locations {
    if place.id == id {
      return Some(place)
    }
  }
  None
}

///|
/// Where a character stands: their own point when they have one, otherwise the
/// centre of the location they belong to.
pub fn Scenario::character_point(
  self : Scenario,
  id : String,
) -> @geometry.Point? {
  match self.character(id) {
    Some(card) =>
      if card.point.x != 0.0 || card.point.y != 0.0 {
        Some(card.point)
      } else {
        match self.location(card.location) {
          // A group sharing one location would otherwise stack on the exact
          // centre and only the last marker would be visible. Spread them around
          // it in cast order, so a scene's members are distinguishable on the
          // map before the player clicks into the scene.
          Some(place) =>
            Some(
              ring_point(
                rect_center(place.rect()),
                place.rect(),
                self.location_slot(id),
                self.location_cast_count(card.location),
              ),
            )
          None => None
        }
      }
    None => None
  }
}

///|
/// How many characters sit at this location without their own coordinates.
///
/// Only those need spreading: a character with an explicit point is already
/// where the author put them.
fn Scenario::location_cast_count(self : Scenario, location : String) -> Int32 {
  let mut count = 0
  for card in self.characters() {
    if card.location == location && card.point.x == 0.0 && card.point.y == 0.0 {
      count += 1
    }
  }
  count
}

///|
/// This character's position among the coordinate-less characters of its own
/// location, in cast order. Stable across reloads because it follows the card
/// order the folder was read in.
fn Scenario::location_slot(self : Scenario, id : String) -> Int32 {
  let mut slot = 0
  let target = self.character(id)
  for card in self.characters() {
    if card.name() == id {
      return slot
    }
    match target {
      Some(wanted) =>
        if card.location == wanted.location &&
          card.point.x == 0.0 &&
          card.point.y == 0.0 {
          slot += 1
        }
      None => ()
    }
  }
  slot
}

///|
/// Spread `count` markers evenly on a small ring inside `bounds`, so several
/// characters at one location do not hide each other. A single character stays
/// exactly at the centre.
fn ring_point(
  center : @geometry.Point,
  bounds : @geometry.Rect,
  slot : Int32,
  count : Int32,
) -> @geometry.Point {
  if count <= 1 {
    return center
  }
  // Keep the ring inside the place, with room for the marker itself.
  let limit = @geometry.Point::new(
    x=bounds.size.width / 2.0 - 18.0,
    y=bounds.size.height / 2.0 - 18.0,
  )
  let radius_x = if limit.x > 12.0 { limit.x } else { 12.0 }
  let radius_y = if limit.y > 12.0 { limit.y } else { 12.0 }
  let angle = 6.283185307179586 * (slot.to_double() + 0.5) / count.to_double()
  let cos = @math.cos(angle)
  let sin = @math.sin(angle)
  @geometry.Point::new(
    x=center.x + radius_x * cos * 0.55,
    y=center.y + radius_y * sin * 0.55,
  )
}

///|
/// Centre of a rect, used to place a character whose card names a location but
/// carries no explicit point.
fn rect_center(rect : @geometry.Rect) -> @geometry.Point {
  @geometry.Point::new(
    x=rect.origin.x + rect.size.width / 2.0,
    y=rect.origin.y + rect.size.height / 2.0,
  )
}
