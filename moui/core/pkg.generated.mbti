pub fn[Msg] View::semantics_expanded(Self[Msg], expanded? : Bool) -> Self[Msg]
pub fn[Msg] View::semantics_invalid(Self[Msg], invalid? : Bool) -> Self[Msg]
pub fn[Msg] View::semantics_pressed(Self[Msg], pressed? : Bool) -> Self[Msg]
pub fn[Msg] View::semantics_required(Self[Msg], required? : Bool) -> Self[Msg]
pub fn[Msg] View::semantics_role(Self[Msg], SemanticsRole) -> Self[Msg]
pub fn[Msg] View::semantics_selected(Self[Msg], selected? : Bool) -> Self[Msg]
pub fn[Msg] View::shadow(Self[Msg], ShadowStyle) -> Self[Msg]
pub fn[Msg] View::sheet(content~ : Self[Msg], presentation_mode~ : SheetPresentationMode, background~ : Brush, corner_radius~ : Double, shadow? : ShadowStyle?, on_dismiss? : Msg?) -> Self[Msg]
pub fn[Msg] View::spacer(min_length? : Double, weight? : Double) -> Self[Msg]
pub fn[Msg] View::spacing(Self[Msg], Double) -> Self[Msg]
pub fn[Msg] View::stack(children~ : Array[Self[Msg]]) -> Self[Msg]
pub fn[Msg] View::text(text~ : String, size~ : Size, font~ : FontSpec, color~ : Color) -> Self[Msg]
pub fn[Msg] View::text_field(value~ : Binding[String], placeholder~ : String, size~ : Size, font~ : FontSpec, foreground~ : Color, placeholder_color~ : Color, background~ : Brush, border? : BorderStyle?, focused_border? : BorderStyle?, cursor_color~ : Color, corner_radius? : Double, on_submit? : Msg?) -> Self[Msg]
pub fn[Msg] View::theme(Self[Msg], Theme) -> Self[Msg]
pub fn[Msg] View::title(Self[Msg]) -> Self[Msg]
pub fn[Msg] View::transition(Self[Msg], spec? : TransitionSpec, progress? : Double, reduced_motion? : Bool) -> Self[Msg]
pub fn[Msg] View::web_view(id~ : String, url~ : String, width? : Double?, height? : Double?, title? : String, policy? : WebViewNavigationPolicy, on_event? : ((WebViewEvent) -> Msg)?) -> Self[Msg]

type ViewEnvironment
pub fn ViewEnvironment::environment(Self) -> Environment
pub fn ViewEnvironment::new(viewport_size~ : Size, environment~ : Environment) -> Self
pub fn ViewEnvironment::viewport_size(Self) -> Size

type ViewNode[Msg]

pub(all) struct ViewNodeInspectorSummary {
  element_id : ElementId
  kind : String
  key : String
  child_count : Int
  needs_build : Bool
  needs_layout : Bool
  needs_paint : Bool
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct ViewStyle {
  font : FontSpec?
  foreground : Color?
  background : Brush?
  corner_radius : Double?
} derive(Eq, ToJson, @debug.Debug)
pub fn ViewStyle::empty() -> Self
pub fn ViewStyle::from_theme(Theme) -> Self
pub fn ViewStyle::merge(Self, Self) -> Self

pub(all) struct ViewTreeInspectorSnapshot {
  root_kind : String
  node_count : Int
  component_count : Int
  control_count : Int
  modified_count : Int
  dirty_build_count : Int
  dirty_layout_count : Int
  dirty_paint_count : Int
  nodes : Array[ViewNodeInspectorSummary]
} derive(Eq, ToJson, @debug.Debug)
pub fn ViewTreeInspectorSnapshot::from_runtime(AppRuntime) -> Self

pub(all) struct VisualStyle {
  background : Brush?
  foreground : Color?
  border : BorderStyle?
  shadow : ShadowStyle?
  radius : Double?
  opacity : Double?
} derive(Eq, ToJson, @debug.Debug)
pub fn VisualStyle::empty() -> Self

pub(all) enum WebViewCommand {
  LoadUrl(String)
  Reload
  Stop
  GoBack
  GoForward
  EvaluateJavaScript(String, String)
} derive(Eq, ToJson, @debug.Debug)
pub fn WebViewCommand::evaluate_javascript(script~ : String, request_id? : String) -> Self
pub fn WebViewCommand::load_url(String) -> Self

pub(all) enum WebViewEvent {
  NavigationRequested(String)
  NavigationStarted(String)
  NavigationCommitted(String)
  NavigationFinished(String)
  NavigationFailed(String, String)
  TitleChanged(String)
  CanGoBackChanged(Bool)
  CanGoForwardChanged(Bool)
  JavaScriptResult(String, String)
} derive(Eq, ToJson, @debug.Debug)

pub(all) enum WebViewNavigationPolicy {
  AllowHttpHttpsFile
  AllowHttpHttps
  AllowAll
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct WebViewSpec {
  key : Key?
  id : String
  url : String
  width : Double?
  height : Double?
  title : String
  policy : WebViewNavigationPolicy
  on_event : ((WebViewEvent) -> Unit)?
}
pub fn WebViewSpec::allows_url(Self, String) -> Bool
pub fn WebViewSpec::new(id~ : String, url~ : String, width? : Double?, height? : Double?, title? : String, policy? : WebViewNavigationPolicy, on_event? : ((WebViewEvent) -> Unit)?) -> Self

