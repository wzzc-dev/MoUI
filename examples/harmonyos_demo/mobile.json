{
  "schemaVersion": 1,
  "id": "harmonyos_demo",
  "displayName": "MoUI HarmonyOS Demo",
  "artifactName": "harmonyos_demo",
  "appPackage": "examples/harmonyos_demo/app",
  "mobile": {
    "fullscreen": true,
    "supportsScroll": false
  },
  "harmonyos": {
    "bundleName": "dev.wzzc.moui.harmonyosdemo",
    "productName": "MoUIHarmonyOSDemo",
    "appName": "MoUI HarmonyOS Demo",
    "moduleName": "entry",
    "moduleDescription": "Experimental MoUI HarmonyOS embedded Skia demo",
    "entryDescription": "MoUI HarmonyOS demo entry ability",
    "native": {
      "moonPackage": "examples/harmonyos_demo/harmonyos_skia",
      "generatedC": "harmonyos_skia.c",
      "nativeLibrary": "moui_harmonyos_demo",
      "appArg": "moui-harmonyos-demo",
      "moonbitMainAlias": "moui_harmonyos_moonbit_generated_main",
      "exports": {
        "attachSurface": "harmonyos_demo_attach_surface",
        "resize": "harmonyos_demo_resize",
        "dispatchPointer": "harmonyos_demo_dispatch_pointer",
        "renderFrame": "harmonyos_demo_render_frame",
        "detachSurface": "harmonyos_demo_detach_surface"
      }
    }
  }
}
