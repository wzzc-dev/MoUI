import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/fs",
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/window/core" @window_core,
  "wzzc-dev/window/dpi",
  "wzzc-dev/window/windows" @win,
}

import {
  "wzzc-dev/moui/views",
} for "wbtest"

supported_targets = "native"

options(
  link: {
    "native": {
      "stub-cc-flags": "${build.MOUI_WINDOWS_WEBVIEW2_STUB_CC_FLAGS}",
      "cc-link-flags": "${build.MOUI_WINDOWS_WEBVIEW2_CC_LINK_FLAGS}",
    },
  },
  "native-stub": [
    "win32_service_host.c",
    "win32_webview_host.cpp",
    "win32_timer_host.c",
  ],
  targets: { },
)
