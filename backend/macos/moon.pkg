import {
  "moonbitlang/core/encoding/utf8",
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/backend/host" @host,
  "wzzc-dev/moui/render" @render,
  "wzzc-dev/moui/render/wgpu" @wgpu_renderer,
  "wzzc-dev/moui/render/wgpu/cosmic_text" @wgpu_cosmic_text,
  "wzzc-dev/moui/render/wgpu/coretext" @wgpu_coretext,
  "Milky2018/wgpu_mbt" @wgpu,
  "Milky2018/wgpu_mbt/c" @wgpu_c,
  "Milky2018/window/core" @window_core,
  "Milky2018/window/dpi" @dpi,
  "Milky2018/window/macos" @window_macos,
}

supported_targets = "native"

options(
  link: {
    "native": {
      "cc-link-flags": "-framework AppKit -framework QuartzCore -framework UniformTypeIdentifiers -lz",
    },
  },
  "native-stub": [ "macos_surface_host.m" ],
  targets: { },
)
