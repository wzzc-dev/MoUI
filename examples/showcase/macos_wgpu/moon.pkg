import {
  "wzzc-dev/moui",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/moui/backend/macos" @macos_backend,
  "wzzc-dev/moui/render/wgpu" @render_wgpu,
  "wzzc-dev/moui/render/wgpu/coretext" @wgpu_coretext,
  "wzzc-dev/moui/render/wgpu/cosmic_text" @wgpu_cosmic,
  "examples/showcase/app",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "" } },
  targets: { "main.mbt": [ "native" ] },
)
