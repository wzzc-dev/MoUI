pub(all) struct SidebarItem[Msg] {
  id : String
  label : String
  message : Msg
  enabled : Bool
}
pub fn[Msg] SidebarItem::new(id~ : String, label~ : String, message~ : Msg, enabled? : Bool) -> Self[Msg]

pub(all) struct StateViewAction[Msg] {
  label : String
  message : Msg
}
pub fn[Msg] StateViewAction::new(label~ : String, message~ : Msg) -> Self[Msg]

pub(all) enum SurfaceVariant {
  Base
  Raised
  Overlay
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct TabItem[Msg] {
  route : String
  label : String
  view : @core.View[Msg]
}

pub(all) struct TableColumn {
  id : String
  label : String
  width : Double
}

pub(all) enum TextFieldVariant {
  Filled
  Outline
  Plain
} derive(Eq, ToJson, @debug.Debug)

pub(all) enum TextRole {
  Body
  Title
  Caption
  Control
  Mono
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct TreeItem {
  id : String
  label : String
  children : Array[TreeItem]
}

pub(all) struct WizardStep[Msg] {
  id : String
  title : String
  subtitle : String
  content : @core.View[Msg]
  enabled : Bool
}
pub fn[Msg] WizardStep::new(id~ : String, title~ : String, subtitle? : String, content~ : @core.View[Msg], enabled? : Bool) -> Self[Msg]

