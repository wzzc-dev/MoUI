    "Indic virama ZWJ consonant conjunct",
  )
  assert_generated_grapheme_break_fixture(
    "\u{915}\u{94D}\u{200D}\u{41}",
    [0, 3, 4],
    "Indic virama ZWJ before Latin breaks",
  )
  assert_generated_grapheme_break_fixture(
    "\u{915}\u{94D}\u{93C}\u{937}",
    [0, 4],
    "Indic virama Extend consonant conjunct",
  )
  assert_generated_grapheme_break_fixture(
    "\u{915}\u{94D}\u{93C}\u{41}",
    [0, 3, 4],
    "Indic virama Extend before Latin breaks",
  )
  assert_generated_grapheme_break_fixture(
    "\u{94D}\u{915}",
