///|
fn format_boundary_fixture_call(helper_name : String, sample : GraphemeSample) -> String {
  let text = escape_moon_string(sample.codepoints)
  let expected = join_ints(sample.boundaries)
  let label = sample_label(sample)
  (
    "  " +
    helper_name +
    "(\n    \"" +
    text +
    "\",\n    [" +
    expected +
    "],\n    \"" +
    label +
    "\",\n  )"
  )
}

///|
fn format_simple_fixture_call(helper_name : String, sample : GraphemeSample) -> String {
  let text = escape_moon_string(sample.codepoints)
  let expected = join_ints(sample.boundaries)
  let label = sample_label(sample)
  "  " +
  helper_name +
  "(\"" +
  text +
  "\", [" +
  expected +
  "], \"" +
  label +
  "\")"
}

///|
fn format_editing_fixture_call(helper_name : String, sample : GraphemeSample) -> String {
  let text = escape_moon_string(sample.codepoints)
  let expected = join_ints(sample.boundaries)
  let utf8 = join_ints(
    utf8_offsets_for_boundaries(sample.codepoints, sample.boundaries),
  )
  let label = sample_label(sample)
  "  " +
  helper_name +
  "(\"" +
  text +
  "\", [" +
  expected +
  "], [" +
  utf8 +
  "], \"" +
  label +
  "\")"
}

///|
fn generate_boundary_fixture(
  input : String,
  helper_name : String,
  test_name : String,
  samples : Array[GraphemeSample],
) -> String {
  let calls = samples.map(sample =>
    format_boundary_fixture_call(helper_name, sample)
  ).join("\n")
  (
    #|///| Generated by scripts/generate-grapheme-break-fixtures.mjs.
    #|
    #|///| Source fixture: 
  ) +
  input +
  "\n\n///|\nfn " +
  helper_name +
  "(\n  text : String,\n  expected : Array[Int],\n  label : String,\n) -> Unit raise {\n  let actual = TextGraphemeBoundaries::new(text~).boundaries()\n  if actual.length() != expected.length() {\n    fail(\n      \"\\{label}: expected \\{expected.length()} grapheme boundaries, got \\{actual.length()}\",\n    )\n  }\n  for index in 0..<expected.length() {\n    inspect(actual[index], content=\"\\{expected[index]}\")\n  }\n}\n\n///|\ntest \"" +
  test_name +
  "\" {\n" +
  calls +
  "\n}\n"
}

///|
fn generate_skia_cluster_fixture(
  input : String,
  helper_name : String,
  test_name : String,
  samples : Array[GraphemeSample],
) -> String {
  let calls = samples.map(sample => format_simple_fixture_call(helper_name, sample)).join(
    "\n",
  )
  (
    #|///| Generated by scripts/generate-grapheme-break-fixtures.mjs.
    #|///| Source fixture: 
  ) +
  input +
  "\n\n///|\nfn " +
  helper_name +
  "_expected_floor(index : Int, expected : Array[Int]) -> Int {\n  let mut floor = 0\n  for boundary in expected {\n    if boundary > index {\n      return floor\n    }\n    floor = boundary\n  }\n  floor\n}\n\n///|\nfn " +
  helper_name +
  "_expected_ceil(index : Int, expected : Array[Int]) -> Int {\n  for boundary in expected {\n    if boundary >= index {\n      return boundary\n    }\n  }\n  match expected.last() {\n    Some(length) => length\n    None => 0\n  }\n}\n\n///|\nfn " +
  helper_name +
  "_expected_nearest(index : Int, expected : Array[Int]) -> Int {\n  let floor = " +
  helper_name +
  "_expected_floor(index, expected)\n  let ceil = " +
  helper_name +
  "_expected_ceil(index, expected)\n  if index - floor <= ceil - index {\n    floor\n  } else {\n    ceil\n  }\n}\n\n///|\nfn " +
  helper_name +
  "_utf8_offset(text : String, boundary : Int) -> Int {\n  let chars = text.to_array()\n  @utf8.encode(String::from_array(chars[:boundary])[:], bom=false).length()\n}\n\n///|\nfn " +
  helper_name +
  "(\n  text : String,\n  expected : Array[Int],\n  label : String,\n) -> Unit raise {\n  let actual = [0]\n  let mut cursor = 0\n  for cluster in skia_grapheme_cluster_texts(text) {\n    cursor += cluster.to_array().length()\n    actual.push(cursor)\n  }\n  if actual.length() != expected.length() {\n    fail(\n      \"\\{label}: expected \\{expected.length()} grapheme boundaries, got \\{actual.length()}\",\n    )\n  }\n  for index in 0..<expected.length() {\n    inspect(actual[index], content=\"\\{expected[index]}\")\n  }\n  let boundaries = @core.TextGraphemeBoundaries::new(text~)\n  let length = text.to_array().length()\n  for index in 0..<(length + 1) {\n    let nearest = " +
  helper_name +
  "_expected_nearest(index, actual)\n    inspect(boundaries.nearest_boundary(index), content=\"\\{nearest}\")\n    inspect(\n      boundaries.nearest_boundary_utf8_offset(index),\n      content=\"\\{" +
  helper_name +
  "_utf8_offset(text, nearest)}\",\n    )\n  }\n}\n\n///|\ntest \"" +
  test_name +
  "\" {\n" +
  calls +
  "\n}\n"
}

///|
fn generate_editing_fixture(
  input : String,
  helper_name : String,
  test_name : String,
  samples : Array[GraphemeSample],
) -> String {
  let calls = samples.map(sample => format_editing_fixture_call(helper_name, sample)).join(
    "\n",
  )
  (
    #|///| Generated by scripts/generate-grapheme-break-fixtures.mjs.
    #|///| Source fixture: 
  ) +
  input +
  "\n\n///|\nfn " +
  helper_name +
  "_expected_floor(index : Int, expected : Array[Int]) -> Int {\n  let mut floor = 0\n  for boundary in expected {\n    if boundary > index {\n      return floor\n    }\n    floor = boundary\n  }\n  floor\n}\n\n///|\nfn " +
  helper_name +
  "_expected_ceil(index : Int, expected : Array[Int]) -> Int {\n  for boundary in expected {\n    if boundary >= index {\n      return boundary\n    }\n  }\n  match expected.last() {\n    Some(length) => length\n    None => 0\n  }\n}\n\n///|\nfn " +
  helper_name +
  "_expected_nearest(index : Int, expected : Array[Int]) -> Int {\n  let floor = " +
  helper_name +
  "_expected_floor(index, expected)\n  let ceil = " +
  helper_name +
  "_expected_ceil(index, expected)\n  if index - floor <= ceil - index {\n    floor\n  } else {\n    ceil\n  }\n}\n\n///|\nfn " +
  helper_name +
  "_expected_boundary_index(\n  boundary : Int,\n  expected : Array[Int],\n  label : String,\n) -> Int raise {\n  for index in 0..<expected.length() {\n    if expected[index] == boundary {\n      return index\n    }\n  }\n  fail(\"\\{label}: expected nearest boundary \\{boundary} to be in fixture\")\n}\n\n///|\nfn " +
  helper_name +
  "(\n  text : String,\n  expected : Array[Int],\n  expected_utf8_offsets : Array[Int],\n  label : String,\n) -> Unit raise {\n  if expected.length() != expected_utf8_offsets.length() {\n    fail(\"\\{label}: expected boundary and UTF-8 fixture lengths to match\")\n  }\n  let boundaries = TextGraphemeBoundaries::new(text~)\n  let actual = boundaries.boundaries()\n  if actual.length() != expected.length() {\n    fail(\n      \"\\{label}: expected \\{expected.length()} grapheme boundaries, got \\{actual.length()}\",\n    )\n  }\n  for index in 0..<expected.length() {\n    let boundary = expected[index]\n    inspect(actual[index], content=\"\\{boundary}\")\n    inspect(boundaries.utf8_offset(boundary), content=\"\\{expected_utf8_offsets[index]}\")\n    inspect(boundaries.is_boundary(boundary), content=\"true\")\n  }\n  let length = boundaries.length()\n  for index in 0..<(length + 1) {\n    let floor = " +
  helper_name +
  "_expected_floor(index, expected)\n    let ceil = " +
  helper_name +
  "_expected_ceil(index, expected)\n    let nearest = " +
  helper_name +
  "_expected_nearest(index, expected)\n    let nearest_utf8_index = " +
  helper_name +
  "_expected_boundary_index(nearest, expected, label)\n    inspect(boundaries.floor_boundary(index), content=\"\\{floor}\")\n    inspect(boundaries.ceil_boundary(index), content=\"\\{ceil}\")\n    inspect(boundaries.nearest_boundary(index), content=\"\\{nearest}\")\n    inspect(\n      boundaries.nearest_boundary_utf8_offset(index),\n      content=\"\\{expected_utf8_offsets[nearest_utf8_index]}\",\n    )\n    let collapsed = boundaries.normalize_range(TextRange::collapsed(index))\n    inspect(collapsed.start, content=\"\\{nearest}\")\n    inspect(collapsed.end, content=\"\\{nearest}\")\n    if index < length {\n      let range_end = " +
  helper_name +
  "_expected_ceil(index + 1, expected)\n      let normalized = boundaries.normalize_range(\n        TextRange::new(start=index, end=index + 1),\n      )\n      inspect(normalized.start, content=\"\\{floor}\")\n      inspect(normalized.end, content=\"\\{range_end}\")\n    }\n  }\n  for index in 1..<expected.length() {\n    let previous = expected[index - 1]\n    let current = expected[index]\n    let delete_before = boundaries.delete_range(current, 1, 0)\n    inspect(delete_before.start, content=\"\\{previous}\")\n    inspect(delete_before.end, content=\"\\{current}\")\n    let delete_after = boundaries.delete_range(previous, 0, 1)\n    inspect(delete_after.start, content=\"\\{previous}\")\n    inspect(delete_after.end, content=\"\\{current}\")\n  }\n}\n\n///|\ntest \"" +
  test_name +
  "\" {\n" +
  calls +
  "\n}\n"
}

///|
fn generate_layout_fixture(
  input : String,
  helper_name : String,
  test_name : String,
  samples : Array[GraphemeSample],
) -> String {
  let calls = samples.map(sample => format_simple_fixture_call(helper_name, sample)).join(
    "\n",
  )
  (
    #|///| Generated by scripts/generate-grapheme-break-fixtures.mjs.
    #|///| Source fixture: 
  ) +
  input +
  "\n\n///|\nfn " +
  helper_name +
  "_expected_floor(index : Int, expected : Array[Int]) -> Int {\n  let mut floor = 0\n  for boundary in expected {\n    if boundary > index {\n      return floor\n    }\n    floor = boundary\n  }\n  floor\n}\n\n///|\nfn " +
  helper_name +
  "_expected_ceil(index : Int, expected : Array[Int]) -> Int {\n  for boundary in expected {\n    if boundary >= index {\n      return boundary\n    }\n  }\n  match expected.last() {\n    Some(length) => length\n    None => 0\n  }\n}\n\n///|\nfn " +
  helper_name +
  "_expected_nearest(index : Int, expected : Array[Int]) -> Int {\n  let floor = " +
  helper_name +
  "_expected_floor(index, expected)\n  let ceil = " +
  helper_name +
  "_expected_ceil(index, expected)\n  if index - floor <= ceil - index {\n    floor\n  } else {\n    ceil\n  }\n}\n\n///|\nfn " +
  helper_name +
  "_assert_same_rect(actual : Rect, expected : Rect) -> Unit raise {\n  inspect(actual.origin.x, content=\"\\{expected.origin.x}\")\n  inspect(actual.origin.y, content=\"\\{expected.origin.y}\")\n  inspect(actual.size.width, content=\"\\{expected.size.width}\")\n  inspect(actual.size.height, content=\"\\{expected.size.height}\")\n}\n\n///|\nfn " +
  helper_name +
  "(\n  text : String,\n  expected : Array[Int],\n  label : String,\n) -> Unit raise {\n  if expected.is_empty() {\n    fail(\"\\{label}: expected at least one grapheme boundary\")\n  }\n  let length = text.to_array().length()\n  let layout = TextSystem::fallback().layout_paragraph(\n    TextLayoutInput::new(\n      text~,\n      font=FontSpec::new(size=16.0, weight=400),\n    ),\n  )\n  assert_true(layout.metadata.selection_rects_available)\n  assert_true(layout.metadata.hit_test_available)\n  inspect(layout.caret_rects.length(), content=\"\\{length + 1}\")\n  for index in 0..<(length + 1) {\n    let nearest = " +
  helper_name +
  "_expected_nearest(index, expected)\n    let expected_caret = layout.caret_rect_at(nearest)\n    " +
  helper_name +
  "_assert_same_rect(layout.caret_rect_at(index), expected_caret)\n    let collapsed = layout.selection_rects(TextRange::collapsed(index))\n    inspect(collapsed.length(), content=\"1\")\n    " +
  helper_name +
  "_assert_same_rect(collapsed[0], expected_caret)\n    let hit = layout.hit_test(\n      Point::new(x=expected_caret.origin.x, y=expected_caret.origin.y + 0.1),\n    )\n    inspect(hit.offset, content=\"\\{nearest}\")\n    assert_true(hit.is_inside)\n  }\n}\n\n///|\ntest \"" +
  test_name +
  "\" {\n" +
  calls +
  "\n}\n"
}

///|
fn generate_fixture(
  actual_kind : String,
  input : String,
  helper_name : String,
  test_name : String,
  samples : Array[GraphemeSample],
) -> Result[String, String] {
  match actual_kind {
    "core-boundaries" =>
      Ok(generate_boundary_fixture(input, helper_name, test_name, samples))
    "core-editing" =>
      Ok(generate_editing_fixture(input, helper_name, test_name, samples))
    "core-layout" =>
      Ok(generate_layout_fixture(input, helper_name, test_name, samples))
    "skia-clusters" =>
      Ok(generate_skia_cluster_fixture(input, helper_name, test_name, samples))
    other => Err("invalid actual kind '" + other + "'")
  }
}
