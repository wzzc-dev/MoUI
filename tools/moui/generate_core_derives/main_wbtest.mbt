///|
test "parse_source collects derives and pub impl traits per type" {
  let source =
    #|///|
    #|#derive(Eq, Debug, ToJson)
    #|pub(all) struct Color {
    #|  r : Double
    #|  g : Double
    #|
    #|///|
    #|#derive(Eq, Compare, Hash, Debug)
    #|pub struct SemanticId {
    #|  priv value : String
    #|}
    #|
    #|///|
    #|pub impl ToJson for SemanticId with fn to_json(self : SemanticId) -> Json {
    #|  Json::Null
    #|}
    #|
    #|///|
    #|pub fn helper() -> Int {
    #|  1
    #|}
    #|
  let parsed = parse_source("test.mbt", source).unwrap()
  assert_eq(parsed.types.length(), 2)
  let color = parsed.types[0]
  assert_eq(color.name, "Color")
  assert_eq(color.derived, ["Eq", "Debug", "ToJson"])
  assert_eq(color.impld.length(), 0)
  let semantic_id = parsed.types[1]
  assert_eq(semantic_id.name, "SemanticId")
  assert_eq(semantic_id.derived, ["Eq", "Compare", "Hash", "Debug"])
  assert_eq(semantic_id.impld, ["ToJson"])
}

///|
test "parse_source rejects boilerplate extends in hand-written sources" {
  let source =
    #|#derive(Eq, Debug, ToJson)
    #|pub(all) struct Color {
    #|  r : Double
    #|}
    #|
    #|pub extend Color with Debug::{to_repr}
    #|
  match parse_source("test.mbt", source) {
    Ok(_) => fail("boilerplate extend must be rejected")
    Err(message) => assert_true(message.contains("boilerplate `pub extend`"))
  }
}

///|
test "parse_source rejects unmapped derive traits" {
  let source =
    #|#derive(Eq, Custom)
    #|pub struct Widget {
    #|  x : Int
    #|}
    #|
  match parse_source("test.mbt", source) {
    Ok(_) => fail("unmapped trait must be rejected")
    Err(message) => assert_true(message.contains("unmapped derive trait"))
  }
}

///|
test "generate_output emits canonical order for derived and hand-implemented traits" {
  let parsed : ParsedSource = {
    types: [
      {
        name: "SemanticId",
        file: "moui/core/semantics.mbt",
        derived: ["Eq", "Compare", "Hash", "Debug"],
        impld: ["ToJson"],
      },
    ],
  }
  let output = match generate_output([parsed]) {
    Ok(value) => value
    Err(message) => abort(message)
  }
  assert_true(
    output.has_prefix("// Generated by tools/moui/generate_core_derives"),
  )
  let order = [
    "pub extend SemanticId with Debug::{to_repr}", "pub extend SemanticId with Eq::{not_equal, equal}",
    "pub extend SemanticId with ToJson::{to_json}", "pub extend SemanticId with Compare::{op_lt, op_le, op_ge, compare, op_gt}",
    "pub extend SemanticId with Hash::{hash, hash_combine}",
  ]
  let mut previous = -1
  for line in order {
    let index = match output.find(line) {
      Some(found) => found
      None => abort("missing extend line: " + line)
    }
    assert_true(index > previous)
    previous = index
  }
}

///|
test "type_decl_name matches visibility and kind prefixes" {
  assert_eq(type_decl_name("pub(all) struct Color {"), Some("Color"))
  assert_eq(type_decl_name("pub enum BlendMode {"), Some("BlendMode"))
  assert_eq(type_decl_name("priv struct Hidden {"), Some("Hidden"))
  assert_eq(type_decl_name("struct Bare {"), Some("Bare"))
  assert_eq(type_decl_name("pub fn Color::rgba()"), None)
  assert_eq(type_decl_name("#derive(Eq)"), None)
}

///|
test "parse_source rejects deprecated suffix derive syntax" {
  let source =
    #|pub struct Widget {
    #|  x : Int
    #|} derive(Eq)
    #|
  match parse_source("test.mbt", source) {
    Ok(_) => fail("deprecated suffix derive syntax must be rejected")
    Err(message) =>
      assert_true(message.contains("deprecated suffix derive syntax"))
  }
}
