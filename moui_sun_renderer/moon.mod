name = "wzzc-dev/moui_sun_renderer"

version = "0.2.0"

preferred_target = "native"

supported_targets = "native"

import {
  "wzzc-dev/moui@0.2.0",
  "wzzc-dev/moui_sun@0.2.0",
  "mizchi/image@0.4.3",
  "moonbitlang/x@0.4.46",
}

