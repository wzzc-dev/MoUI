///|
fn sample_manifest() -> String {
  (
    #|{
    #|  "schemaVersion": 1,
    #|  "catalogs": ["zh-Hans.json", "en-US.json"]
    #|}
    #|
  )
}

///|
fn sample_en_catalog() -> String {
  (
    #|{
    #|  "locale": "en-US",
    #|  "messages": {
    #|    "welcome.title": "Welcome, {name}",
    #|    "items.count": { "one": "{count} item", "other": "{count} items" }
    #|  }
    #|}
    #|
  )
}

///|
fn sample_zh_catalog() -> String {
  (
    #|{
    #|  "locale": "zh-Hans",
    #|  "messages": {
    #|    "items.count": { "one": "{count} 个项目", "other": "{count} 个项目" },
    #|    "welcome.title": "欢迎，{name}"
    #|  }
    #|}
    #|
  )
}

///|
fn sample_catalog_texts() -> Map[String, String] {
  let catalogs : Map[String, String] = Map([])
  catalogs["/fixtures/en-US.json"] = sample_en_catalog()
  catalogs["/fixtures/zh-Hans.json"] = sample_zh_catalog()
  catalogs
}

///|
test "generates deterministic sorted catalogs with provenance" {
  let manifest = sample_manifest()
  let catalogs = sample_catalog_texts()
  let first = match
    generate_from_texts("/fixtures/catalogs.json", manifest, catalogs) {
    Ok(value) => value
    Err(message) => fail(message)
  }
  let second = match
    generate_from_texts("/fixtures/catalogs.json", manifest, catalogs) {
    Ok(value) => value
    Err(message) => fail(message)
  }
  inspect(first == second, content="true")
  inspect(
    first.contains(
      "Generated by scripts/generate-i18n-catalogs.mjs; DO NOT EDIT.",
    ),
    content="true",
  )
  inspect(
    first.contains(
      "Provenance: manifest=/fixtures/catalogs.json; catalogs=/fixtures/en-US.json, /fixtures/zh-Hans.json.",
    ),
    content="true",
  )
  inspect(
    first.find("locale: \"en-US\"").unwrap() <
    first.find("locale: \"zh-Hans\"").unwrap(),
    content="true",
  )
  inspect(
    first.find("\"items.count\"").unwrap() <
    first.find("\"welcome.title\"").unwrap(),
    content="true",
  )
  inspect(
    first.contains("GeneratedI18nMessage::Plural(") &&
    first.contains("one=\"{count} item\"") &&
    first.contains("other=\"{count} items\""),
    content="true",
  )
}

///|
test "rejects malformed JSON and filename locale mismatches" {
  let one_catalog_manifest = "{\"schemaVersion\":1,\"catalogs\":[\"en-US.json\"]}\n"
  let malformed : Map[String, String] = Map([])
  malformed["/fixtures/en-US.json"] = "{"
  match
    generate_from_texts(
      "/fixtures/catalogs.json", one_catalog_manifest, malformed,
    ) {
    Err(message) =>
      inspect(message, content="/fixtures/en-US.json contains invalid JSON")
    Ok(_) => fail("expected malformed JSON error")
  }

  let mismatched : Map[String, String] = Map([])
  mismatched["/fixtures/en-US.json"] = "{\"locale\":\"zh-Hans\",\"messages\":{\"welcome.title\":\"Welcome\"}}\n"
  match
    generate_from_texts(
      "/fixtures/catalogs.json", one_catalog_manifest, mismatched,
    ) {
    Err(message) =>
      inspect(
        message,
        content="/fixtures/en-US.json.locale zh-Hans does not match filename locale en-US",
      )
    Ok(_) => fail("expected locale mismatch error")
  }
}

///|
test "rejects key and placeholder parity violations" {
  let catalogs = sample_catalog_texts()
  catalogs["/fixtures/zh-Hans.json"] = (
    #|{
    #|  "locale": "zh-Hans",
    #|  "messages": {
    #|    "welcome.title": "欢迎，{person}"
    #|  }
    #|}
    #|
  )
  match
    generate_from_texts("/fixtures/catalogs.json", sample_manifest(), catalogs) {
    Err(message) =>
      inspect(
        message,
        content="/fixtures/zh-Hans.json is missing message key: items.count",
      )
    Ok(_) => fail("expected key parity error")
  }

  let placeholder_catalogs = sample_catalog_texts()
  placeholder_catalogs["/fixtures/zh-Hans.json"] = (
    #|{
    #|  "locale": "zh-Hans",
    #|  "messages": {
    #|    "items.count": { "one": "{count} 个项目", "other": "{count} 个项目" },
    #|    "welcome.title": "欢迎，{person}"
    #|  }
    #|}
    #|
  )
  match
    generate_from_texts(
      "/fixtures/catalogs.json",
      sample_manifest(),
      placeholder_catalogs,
    ) {
    Err(message) =>
      inspect(
        message,
        content="/fixtures/zh-Hans.json.messages.welcome.title placeholder set differs from /fixtures/en-US.json",
      )
    Ok(_) => fail("expected placeholder parity error")
  }
}

///|
test "rejects plural schemas and plural placeholder drift" {
  let one_catalog_manifest = "{\"schemaVersion\":1,\"catalogs\":[\"en-US.json\"]}\n"
  let malformed_plural : Map[String, String] = Map([])
  malformed_plural["/fixtures/en-US.json"] = (
    #|{
    #|  "locale": "en-US",
    #|  "messages": { "items.count": { "one": "one" } }
    #|}
    #|
  )
  match
    generate_from_texts(
      "/fixtures/catalogs.json", one_catalog_manifest, malformed_plural,
    ) {
    Err(message) =>
      inspect(
        message,
        content="/fixtures/en-US.json.messages.items.count plural messages must contain exactly string one and other forms",
      )
    Ok(_) => fail("expected plural schema error")
  }

  let placeholder_drift : Map[String, String] = Map([])
  placeholder_drift["/fixtures/en-US.json"] = (
    #|{
    #|  "locale": "en-US",
    #|  "messages": {
    #|    "items.count": { "one": "{count} item", "other": "{total} items" }
    #|  }
    #|}
    #|
  )
  match
    generate_from_texts(
      "/fixtures/catalogs.json", one_catalog_manifest, placeholder_drift,
    ) {
    Err(message) =>
      inspect(
        message,
        content="/fixtures/en-US.json.messages.items.count plural one and other forms must use the same placeholders",
      )
    Ok(_) => fail("expected plural placeholder error")
  }
}

///|
test "rejects duplicate JSON message keys" {
  let catalog : Map[String, String] = Map([])
  catalog["/fixtures/en-US.json"] = "{\"locale\":\"en-US\",\"messages\":{\"welcome.title\":\"Welcome\",\"welcome.title\":\"Again\"}}\n"
  match
    generate_from_texts(
      "/fixtures/catalogs.json", "{\"schemaVersion\":1,\"catalogs\":[\"en-US.json\"]}\n",
      catalog,
    ) {
    Err(message) =>
      inspect(
        message,
        content="/fixtures/en-US.json contains duplicate JSON object key: welcome.title",
      )
    Ok(_) => fail("expected duplicate key error")
  }
}

///|
test "validates locale tags and duplicate manifest catalog paths" {
  let one_catalog_manifest = "{\"schemaVersion\":1,\"catalogs\":[\"en-US.json\"]}\n"
  let invalid_locale : Map[String, String] = Map([])
  invalid_locale["/fixtures/en-US.json"] = "{\"locale\":\"en_us\",\"messages\":{\"welcome.title\":\"Welcome\"}}\n"
  match
    generate_from_texts(
      "/fixtures/catalogs.json", one_catalog_manifest, invalid_locale,
    ) {
    Err(message) =>
      inspect(
        message,
        content="/fixtures/en-US.json.locale is not a valid locale tag: en_us",
      )
    Ok(_) => fail("expected invalid locale error")
  }

  let duplicate_path_manifest = "{\"schemaVersion\":1,\"catalogs\":[\"en-US.json\",\"en-US.json\"]}\n"
  match
    generate_from_texts(
      "/fixtures/catalogs.json",
      duplicate_path_manifest,
      Map([]),
    ) {
    Err(message) =>
      inspect(
        message,
        content="/fixtures/catalogs.json.catalogs[1] duplicates catalog path: en-US.json",
      )
    Ok(_) => fail("expected duplicate manifest path error")
  }
}
