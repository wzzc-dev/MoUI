///|
struct CliOptions {
  grapheme_property : String
  emoji_data : String
  derived_core_properties : String
  output : String
  check : Bool
  help : Bool
}

///|
fn usage() -> String {
  (
    #|Usage: tools/moui/generate_grapheme_property_data
    #|  --grapheme-property <GraphemeBreakProperty.txt>
    #|  --emoji-data <emoji-data.txt>
    #|  --derived-core-properties <DerivedCoreProperties.txt>
    #|  [--output <text_grapheme_data.mbt>]
    #|  [--check]
    #|
    #|The default output is moui/core/unicode/grapheme_data.mbt.
    #|
  )
}

///|
fn parse_cli(args : Array[String]) -> Result[CliOptions, String] {
  let mut grapheme_property = ""
  let mut emoji_data = ""
  let mut derived_core_properties = ""
  let mut output = "moui/core/unicode/grapheme_data.mbt"
  let mut check = false
  let mut help = false
  let mut index = 0
  while index < args.length() {
    match args[index] {
      "-h" | "--help" => {
        help = true
        index += 1
      }
      "--grapheme-property" => {
        if index + 1 >= args.length() {
          return Err("missing value for --grapheme-property")
        }
        grapheme_property = args[index + 1]
        index += 2
      }
      "--emoji-data" => {
        if index + 1 >= args.length() {
          return Err("missing value for --emoji-data")
        }
        emoji_data = args[index + 1]
        index += 2
      }
      "--derived-core-properties" => {
        if index + 1 >= args.length() {
          return Err("missing value for --derived-core-properties")
        }
        derived_core_properties = args[index + 1]
        index += 2
      }
      "--output" => {
        if index + 1 >= args.length() {
          return Err("missing value for --output")
        }
        output = args[index + 1]
        index += 2
      }
      "--check" => {
        check = true
        index += 1
      }
      value => return Err("Unknown argument: " + value)
    }
  }
  Ok({
    grapheme_property,
    emoji_data,
    derived_core_properties,
    output,
    check,
    help,
  })
}

///|
fn grapheme_property_names() -> Array[String] {
  [
    "CR", "LF", "Control", "Prepend", "Extend", "SpacingMark", "Regional_Indicator",
    "ZWJ",
  ]
}

///|
fn generate_from_sources(
  grapheme_text : String,
  grapheme_source : String,
  emoji_text : String,
  emoji_source : String,
  derived_text : String,
  derived_source : String,
) -> Result[String, String] {
  let grapheme_ranges = match
    parse_property_ranges(
      grapheme_text,
      grapheme_source,
      grapheme_property_names(),
    ) {
    Ok(value) => value
    Err(message) => return Err(message)
  }
  let emoji_ranges = match
    parse_property_ranges(emoji_text, emoji_source, ["Extended_Pictographic"]) {
    Ok(value) => value
    Err(message) => return Err(message)
  }
  let indic = match parse_indic_conjunct_ranges(derived_text, derived_source) {
    Ok(value) => value
    Err(message) => return Err(message)
  }
  let parts = [
    function_for_ranges(
      "unicode_grapheme_is_cr_17_0",
      ranges_or_empty(grapheme_ranges, "CR"),
    ),
    function_for_ranges(
      "unicode_grapheme_is_lf_17_0",
      ranges_or_empty(grapheme_ranges, "LF"),
    ),
    function_for_ranges(
      "unicode_grapheme_is_control_17_0",
      ranges_or_empty(grapheme_ranges, "Control"),
    ),
    function_for_ranges(
      "unicode_grapheme_is_prepend_17_0",
      ranges_or_empty(grapheme_ranges, "Prepend"),
    ),
    function_for_ranges(
      "unicode_grapheme_is_extend_17_0",
      ranges_or_empty(grapheme_ranges, "Extend"),
    ),
    function_for_ranges(
      "unicode_grapheme_is_spacing_mark_17_0",
      ranges_or_empty(grapheme_ranges, "SpacingMark"),
    ),
    function_for_ranges(
      "unicode_grapheme_is_regional_indicator_17_0",
      ranges_or_empty(grapheme_ranges, "Regional_Indicator"),
    ),
    function_for_ranges(
      "unicode_grapheme_is_zwj_17_0",
      ranges_or_empty(grapheme_ranges, "ZWJ"),
    ),
    function_for_ranges(
      "unicode_emoji_is_extended_pictographic_17_0",
      ranges_or_empty(emoji_ranges, "Extended_Pictographic"),
    ),
    function_for_ranges(
      "unicode_indic_conjunct_is_linker_17_0",
      ranges_or_empty(indic, "Linker"),
    ),
    function_for_ranges(
      "unicode_indic_conjunct_is_consonant_17_0",
      ranges_or_empty(indic, "Consonant"),
    ),
    function_for_ranges(
      "unicode_indic_conjunct_is_extend_17_0",
      ranges_or_empty(indic, "Extend"),
    ),
  ]
  Ok(
    "///| Generated by scripts/generate-grapheme-property-data.mjs.\n\n" +
    "///| Sources: Unicode 17.0.0 GraphemeBreakProperty.txt, emoji-data.txt, and\n\n" +
    "///| DerivedCoreProperties.txt.\n\n" +
    "///| Unicode data terms: https://www.unicode.org/terms_of_use.html\n\n" +
    parts.join("\n"),
  )
}

///|
fn run(args : Array[String]) -> Int {
  match parse_cli(args) {
    Err(message) => {
      println(message)
      println(usage())
      2
    }
    Ok(options) => {
      if options.help {
        println(usage())
        return 0
      }
      if options.grapheme_property == "" ||
        options.emoji_data == "" ||
        options.derived_core_properties == "" ||
        options.output == "" {
        println(usage())
        return 2
      }
      let grapheme_text = match
        @tools.read_required_text(
          options.grapheme_property,
          options.grapheme_property,
        ) {
        Ok(value) => value
        Err(message) => {
          println(message)
          return 1
        }
      }
      let emoji_text = match
        @tools.read_required_text(options.emoji_data, options.emoji_data) {
        Ok(value) => value
        Err(message) => {
          println(message)
          return 1
        }
      }
      let derived_text = match
        @tools.read_required_text(
          options.derived_core_properties,
          options.derived_core_properties,
        ) {
        Ok(value) => value
        Err(message) => {
          println(message)
          return 1
        }
      }
      let generated = match
        generate_from_sources(
          grapheme_text,
          options.grapheme_property,
          emoji_text,
          options.emoji_data,
          derived_text,
          options.derived_core_properties,
        ) {
        Ok(value) => value
        Err(message) => {
          println(message)
          return 1
        }
      }
      if options.check {
        match @tools.read_required_text(options.output, options.output) {
          Ok(current) =>
            if current != generated {
              println(
                options.output +
                ": generated Unicode grapheme property data is out of date",
              )
              1
            } else {
              println(options.output + ": ok")
              0
            }
          Err(message) => {
            println(options.output + ": " + message)
            1
          }
        }
      } else {
        match
          @tools.write_text_file(options.output, generated, options.output) {
          Ok(_) => {
            println("wrote " + options.output)
            0
          }
          Err(message) => {
            println(message)
            1
          }
        }
      }
    }
  }
}

///|
fn main {
  let code = run(@tools.args_without_program(@env.args()))
  if code != 0 {
    @sys.exit(code)
  }
}
