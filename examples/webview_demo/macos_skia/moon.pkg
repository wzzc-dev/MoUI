import {
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui_webview/host" @webview_host,
  "wzzc-dev/moui_webview/backend/macos" @macos_webview,
  "wzzc-dev/moui/backend/macos/skia" @macos_skia_backend,
  "examples/webview_demo/app" @webview_demo,
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "" } },
  targets: { "main.mbt": [ "native" ] },
)
