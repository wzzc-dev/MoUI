import {
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/moui/backend/platform_bridge",
  "wzzc-dev/moui/backend/macos" @macos_host,
  "wzzc-dev/moui/render",
  "wzzc-dev/moui/render/wgpu" @wgpu_renderer,
  "wzzc-dev/moui/render/wgpu/coretext" @wgpu_coretext,
  "wzzc-dev/moui/render/wgpu/cosmic_text" @wgpu_cosmic_text,
  "Milky2018/wgpu_mbt",
  "Milky2018/wgpu_mbt/c" @wgpu_c,
  "wzzc-dev/window/macos" @window_macos,
}

supported_targets = "native"

options(
  link: {
    "native": {
      "cc-link-flags": "-framework AppKit -framework QuartzCore -framework UniformTypeIdentifiers -framework WebKit -framework CoreText -framework CoreGraphics -framework Foundation -framework CoreFoundation -lobjc -lz",
    },
  },
  "native-stub": [ "macos_wgpu_surface_host.m" ],
  targets: { },
)
