import {
  "wzzc-dev/moui/backend/windows/wgpu" @windows_wgpu,
  "examples/markdown_editor/app" @markdown_app,
  "wzzc-dev/moui/render/wgpu" @wgpu_renderer,
}

supported_targets = "native"

options(
  "is-main": true,
  link: {
    "native": {
      "cc-link-flags": "-Wl,--subsystem,windows -lz -lcomdlg32 -lshell32 -ladvapi32 -lole32 -luser32",
    },
  },
  targets: { "main.mbt": [ "native" ] },
)
