import {
  "moonbitlang/core/env",
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/backend" @moui_host,
  "wzzc-dev/moui/render",
  "wzzc-dev/moui_webview/host",
  "wzzc-dev/window/linux" @window_linux,
}

supported_targets = "native"

options(
  link: {
    "native": {
      "stub-cc-flags": "${build.MOUI_LINUX_WEBKITGTK_STUB_CC_FLAGS}",
      "cc-link-flags": "${build.MOUI_LINUX_WEBKITGTK_CC_LINK_FLAGS}",
    },
  },
  "native-stub": [ "webview_host.c" ],
  targets: { },
)
