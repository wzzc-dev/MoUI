name = "wzzc-dev/moui_tui_renderer"

version = "0.5.1"

preferred_target = "native"

supported_targets = "native"

import {
  "wzzc-dev/moui@0.5.1",
  "wzzc-dev/moui_tui@0.5.1",
}

repository = "https://github.com/wzzc-dev/MoUI.git"

license = "Apache-2.0"

keywords = [ "moui", "tui", "renderer", "terminal", "ansi", "experimental" ]

description = "Experimental terminal cell renderer: projects MoUI semantics frames into ANSI text"
