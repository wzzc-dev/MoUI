import {
  "moonbitlang/core/env",
  "wzzc-dev/moui/backend/macos/skia" @macos_skia_backend,
  "wzzc-dev/moui/render/skia" @skia_renderer,
  "wzzc-dev/moui/render",
  "wzzc-dev/moui_tester/fixtures/text_input_app" @fixture,
}

supported_targets = "native"

options(
  "is-main": true,
  link: {
    "native": {
      "cc-link-flags": "-framework AppKit -framework QuartzCore -framework UniformTypeIdentifiers -framework WebKit -lz ${build.MOUI_SKIA_CC_LINK_FLAGS}",
    },
  },
  targets: { "main.mbt": [ "native" ] },
)
