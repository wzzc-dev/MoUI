import {
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/core/diagnostics",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/render",
  "wzzc-dev/moui/render/common" @render_common,
  "wzzc-dev/moui/backend" @backend_host,
  // The view-level context-menu fallback builds its layer from the same
  // command-menu components the app uses, so the driver depends on the views
  // facade rather than duplicating a menu control here.
  "wzzc-dev/moui/views",
}

supported_targets = "+native+wasm-gc+wasm"

options(
  targets: { },
)
