import {
  "wzzc-dev/moui/apphost",
  "wzzc-dev/moui/backend/common/lifecycle" @backend_common,
  "wzzc-dev/moui/backend/linux",
  "wzzc-dev/moui/services",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui_sun_renderer" @render_sun,
  "examples/chrome_demo/app" @demo,
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "" } },
  targets: { "main.mbt": [ "native" ] },
)
