import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
}

supported_targets = "+native"

options(
  "native-stub": [ "native_fs.c", "native_process.c" ],
  "pre-build": [
    {
      "input": "moon.mod",
      "output": "version_manifest.mbt",
      "command": ":embed -i $input -o $output --name embedded_module_manifest --text",
    },
  ],
)
