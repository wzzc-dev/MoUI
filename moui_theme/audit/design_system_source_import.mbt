///|
fn imported_token(
  preset : @common.DesignPreset,
  category : DesignTokenCategory,
  layer : DesignTokenLayer,
  token_name : String,
  source_url : String,
  source_ref : String,
  token_path : String,
  package_path : String,
  source_file : String,
  source_sha : String,
  source_value : String,
  moui_token : String,
  status : DesignTokenStatus,
  note : String,
  official_token? : String = "",
) -> DesignSourceImportedToken {
  let official_token = if official_token == "" {
    token_name
  } else {
    official_token
  }
  {
    preset,
    category,
    layer,
    official_token,
    token_name,
    source_url,
    source_ref,
    token_path,
    package_path,
    source_file,
    source_sha,
    source_value,
    moui_token,
    status,
    note,
  }
}
