import {
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/moui/backend/ios" @ios_host,
  "wzzc-dev/moui/backend/ios/skia" @ios_skia_backend,
  "examples/component_gallery/app" @component_gallery_app,
}

supported_targets = "native"

options(
  "is-main": true,
  link: {
    "native": {
      "exports": [
        "moui_mobile_take_host_updates_json",
        "moui_mobile_dispatch_text_input",
        "moui_mobile_dispatch_command",
        "moui_mobile_dispatch_accessibility",
        "moui_mobile_complete_clipboard",
        "component_gallery_ios_attach_view",
        "component_gallery_ios_resize",
        "component_gallery_ios_dispatch_pointer",
        "component_gallery_ios_dispatch_scroll",
        "component_gallery_ios_frame_tick",
        "component_gallery_ios_render_frame",
        "component_gallery_ios_detach_view",
      ],
    },
  },
  targets: { "main.mbt": [ "native" ] },
)
