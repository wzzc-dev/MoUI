import {
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/moui/backend/platform_bridge",
  "wzzc-dev/moui/backend/macos" @macos_host,
  "wzzc-dev/moui/render",
  "wzzc-dev/moui/render/skia" @skia_renderer,
  "wzzc-dev/moui_skia",
  "wzzc-dev/moui_skia/native" @skia_native,
  "wzzc-dev/window/core" @window_core,
  "wzzc-dev/window/dpi",
  "wzzc-dev/window/macos" @window_macos,
}

import {
  "moonbitlang/core/encoding/base64",
  "moonbitlang/x/fs",
  "wzzc-dev/moui/core",
} for "wbtest"

supported_targets = "native"

options(
  link: {
    "native": {
      "stub-cc-flags": "${build.MOUI_SKIA_STUB_CC_FLAGS}",
      "cc-link-flags": "-framework AppKit -framework QuartzCore -framework Metal -framework UniformTypeIdentifiers -framework CoreGraphics -framework CoreFoundation -lz",
    },
  },
  "native-stub": [ "macos_skia_presenter.mm", "macos_async_image.mm" ],
  targets: { },
)
