import {
  "wzzc-dev/moui",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/moui/backend/windows" @windows_host,
  "wzzc-dev/moui/render/wgpu" @render_wgpu,
  "wzzc-dev/moui/render/wgpu/directwrite" @wgpu_directwrite,
  "wzzc-dev/moui/render/wgpu/cosmic_text" @wgpu_cosmic,
  "examples/markdown_editor/app" @markdown_app,
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "" } },
  targets: { "main.mbt": [ "native" ] },
)
