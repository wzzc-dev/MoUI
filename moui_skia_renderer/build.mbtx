---
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
}
---

///|
/// Skia renderer prebuild hook (`--moonbit-unstable-prebuild`).
///
/// Port of the former `build.js`. The renderer owns no Skia flags of its own, so
/// it delegates to the `moui_skia` module prebuild (a `.mbtx` script) and
/// re-emits the two vars it needs plus one `link_configs` entry. Package
/// `cc-link-flags` cover binding-local tests but do not propagate through the
/// renderer to final is-main links, so the link configs entry is the carrier.

///|
struct RendererOpts {
  parent_root : String
}

///|
fn[T] bail(message : String) -> T {
  abort(message)
}

///|
fn is_blank(value : String) -> Bool {
  value.trim().length() == 0
}

///|
fn lower_trim(value : String) -> String {
  value.trim().to_owned().to_lower()
}

///|
fn truthy(value : String) -> Bool {
  let text = lower_trim(value)
  text == "1" || text == "true" || text == "yes" || text == "on"
}

///|
fn falsy(value : String) -> Bool {
  let text = lower_trim(value)
  text == "0" || text == "false" || text == "no" || text == "off"
}

///|
fn split_str(value : String, delimiter : String) -> Array[String] {
  let parts : Array[String] = []
  for part in value.split(delimiter) {
    parts.push(part.to_owned())
  }
  parts
}

///|
fn path_join(left : String, right : String) -> String {
  if left == "" {
    return right
  }
  if right == "" {
    return left
  }
  if left.has_suffix("/") || left.has_suffix("\\") {
    return left + right
  }
  left + "/" + right
}

///|
fn path_exists(path : String) -> Bool {
  @fs.path_exists(path)
}

///|
fn ensure_dir(path : String) -> Unit {
  if path_exists(path) {
    return
  }
  @fs.create_dir(path) catch {
    _ => bail("failed to create directory \{path}")
  }
}

///|
fn json_field(value : @json.Json, key : String) -> @json.Json? {
  match value {
    @json.Object(fields) => fields.get(key)
    _ => None
  }
}

///|
fn config_value(key : String) -> String? {
  match @env.get_env_var(key) {
    Some(value) => if is_blank(value) { None } else { Some(value) }
    None => None
  }
}

///|
fn config_or(key : String, fallback : String) -> String {
  match config_value(key) {
    Some(value) => value
    None => fallback
  }
}

///|
fn target_kind() -> String? {
  match config_value("MOON_BACKEND") {
    Some(kind) => Some(kind)
    None => config_value("MOON_TARGET")
  }
}

///|
fn should_configure_skia(opts : RendererOpts) -> Bool {
  match target_kind() {
    Some(kind) => {
      let text = lower_trim(kind)
      for skipped in ["wasm", "wasm32", "wasmgc", "wasm-gc", "js"] {
        if text == skipped {
          return false
        }
      }
    }
    None => ()
  }
  if truthy(config_or("MOUI_SKIA_DISABLE_PREBUILD_SKIA", "")) {
    return false
  }
  !falsy(config_or("MOUI_SKIA_ENABLE_PREBUILD_SKIA", ""))
}

///|
async fn capture(
  program : String,
  args : Array[String],
  cwd : String,
  extra_env : Map[String, String],
) -> (Int, String, String) {
  let result = @process.run(
    program,
    args,
    extra_env=extra_env,
    stdout=@process.Collect,
    stderr=@process.Collect,
    cwd=cwd,
  )
  let out = result.stdout_text() catch {
    _ => ""
  }
  let err = result.stderr_text() catch {
    _ => ""
  }
  (result.exit_code, out, err)
}

///|
fn var_from_json(parsed : @json.Json, name : String) -> String {
  match json_field(parsed, "vars") {
    Some(vars) =>
      match json_field(vars, name) {
        Some(@json.String(value)) => value
        _ => ""
      }
    None => ""
  }
}

///|
fn var_from_output(output : String, name : String) -> String {
  let lines = split_str(output, "\n")
  let mut index = lines.length() - 1
  while index >= 0 {
    let line = lines[index].trim()
    if line.has_prefix("{") {
      let parsed = @json.parse(line) catch {
        _ => @json.Json::empty_object()
      }
      match json_field(parsed, "vars") {
        Some(vars) => {
          match json_field(vars, name) {
            Some(@json.String(value)) => return value
            _ => ()
          }
        }
        None => ()
      }
    }
    index = index - 1
  }
  ""
}

///|
/// moon may run the module prebuild hooks of one build concurrently, and both the
/// renderer hook and the `moui_tests` delegation end up nesting a moon in
/// `moui_skia`. Each caller therefore gets its own target/dep cache subtree;
/// sharing one made two concurrent nested links write the same `single.exe` and
/// one of them failed with MSVC `D8018` (cannot create linker response file).
fn cache_key_for_caller() -> String {
  match @env.get_env_var("MOUI_SKIA_PREBUILD_CACHE_NAMESPACE") {
    Some(value) => if is_blank(value) { "renderer" } else { value }
    None => "renderer"
  }
}

///|
async fn run_parent_prebuild(opts : RendererOpts) -> String {
  let cache_dir = path_join(opts.parent_root, ".skia-cache")
  ensure_dir(cache_dir)
  let cache_key = cache_key_for_caller()
  let target_dir = path_join(cache_dir, "prebuild-target-\{cache_key}")
  // The parent moon keeps the shared dependency source cache locked for the
  // whole build, so a nested moon that reuses it fails hard with `Unable to
  // lock dependency source cache`. Give the nested resolve its own cache under
  // the module's `.skia-cache/` so it never contends with the parent lock.
  let dep_cache = path_join(cache_dir, "prebuild-dep-cache-\{cache_key}")
  // The parent build runs several native prebuilds at once and MSVC keeps its
  // debug record and linker response files in TMP; concurrent `cl` runs sharing
  // one TMP fail with `D8018`/`D8050`. Give the nested build its own TMP.
  let tmp_dir = path_join(cache_dir, "prebuild-tmp-\{cache_key}")
  ensure_dir(tmp_dir)
  let (code, out, err) = capture(
    "moon",
    ["run", "build.mbtx", "--target", "native", "--target-dir", target_dir],
    opts.parent_root,
    Map([
      ("MOON_DEP_CACHE", dep_cache),
      ("TMP", tmp_dir),
      ("TEMP", tmp_dir),
      ("TMPDIR", tmp_dir),
    ]),
  )
  if code != 0 {
    bail("moui_skia prebuild exited with \{code}: \{err}\n\{out}")
  }
  out
}

///|
fn json_strings(pairs : Array[(String, String)]) -> @json.Json {
  let fields : Map[String, @json.Json] = Map([])
  for pair in pairs {
    fields.set(pair.0, @json.Json::string(pair.1))
  }
  @json.Json::object(fields)
}

///|
fn json_link_configs(pairs : Array[(String, String)]) -> @json.Json {
  let entries : Array[@json.Json] = []
  for pair in pairs {
    let fields : Map[String, @json.Json] = Map([])
    fields.set("package", @json.Json::string(pair.0))
    fields.set("link_flags", @json.Json::string(pair.1))
    entries.push(@json.Json::object(fields))
  }
  @json.Json::array(entries)
}

///|
fn emit(vars : Array[(String, String)], link_configs : Array[(String, String)]) -> Unit {
  let payload : Map[String, @json.Json] = Map([])
  payload.set("vars", json_strings(vars))
  payload.set("link_configs", json_link_configs(link_configs))
  println(@json.Json::object(payload).stringify())
}

///|
async fn main {
  let module_root = match @env.current_dir() {
    Some(dir) => dir
    None => "."
  }
  let opts : RendererOpts = {
    parent_root: path_join(module_root, "../moui_skia"),
  }
  let configure = should_configure_skia(opts)
  let mut stub_flags = ""
  let mut link_flags = ""
  if configure {
    match config_value("MOUI_SKIA_PREBUILD_CONTRACT_FILE") {
      Some(contract_path) => {
        // The RISC-V64 cross build precomputes the parent contract with the
        // host toolchain before it exports MOON_CC. Reading that file avoids a
        // nested `moon run` under the cross compiler.
        let contract_text = @fs.read_file_to_string(contract_path) catch {
          _ => bail("failed to read MOUI_SKIA_PREBUILD_CONTRACT_FILE: \{contract_path}")
        }
        let contract = @json.parse(contract_text) catch {
          _ => bail("failed to parse MOUI_SKIA_PREBUILD_CONTRACT_FILE: \{contract_path}")
        }
        stub_flags = config_or(
          "MOUI_SKIA_STUB_CC_FLAGS",
          var_from_json(contract, "MOUI_SKIA_STUB_CC_FLAGS"),
        )
        link_flags = config_or(
          "MOUI_SKIA_CC_LINK_FLAGS",
          var_from_json(contract, "MOUI_SKIA_CC_LINK_FLAGS"),
        )
      }
      None => {
        let parent_out = run_parent_prebuild(opts)
        stub_flags = config_or(
          "MOUI_SKIA_STUB_CC_FLAGS",
          var_from_output(parent_out, "MOUI_SKIA_STUB_CC_FLAGS"),
        )
        link_flags = config_or(
          "MOUI_SKIA_CC_LINK_FLAGS",
          var_from_output(parent_out, "MOUI_SKIA_CC_LINK_FLAGS"),
        )
      }
    }
  }
  let link_configs = if link_flags == "" {
    []
  } else {
    [("wzzc-dev/moui_skia_renderer", link_flags)]
  }
  emit(
    [
      ("MOUI_SKIA_STUB_CC_FLAGS", stub_flags),
      ("MOUI_SKIA_CC_LINK_FLAGS", link_flags),
    ],
    link_configs,
  )
}
