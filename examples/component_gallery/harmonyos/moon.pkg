import {
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/moui/backend/harmonyos" @harmonyos_host,
  "wzzc-dev/moui/backend/harmonyos/skia" @harmonyos_skia_backend,
  "examples/component_gallery/app" @component_gallery_app,
}

supported_targets = "native"

options(
  "is-main": true,
  link: {
    "native": {
      "exports": [
        "component_gallery_harmonyos_attach_surface",
        "component_gallery_harmonyos_resize",
        "component_gallery_harmonyos_dispatch_pointer",
        "component_gallery_harmonyos_dispatch_scroll",
        "component_gallery_harmonyos_render_frame",
        "component_gallery_harmonyos_detach_surface",
      ],
    },
  },
  targets: { "main.mbt": [ "native" ] },
)
