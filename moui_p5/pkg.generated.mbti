pub fn VAlign::equal(Self, Self) -> Bool
pub fn VAlign::not_equal(Self, Self) -> Bool

pub struct Vector {
  mut x : Double
  mut y : Double
  mut z : Double
}
pub fn Vector::add(Self, Self) -> Unit
pub fn Vector::angle_between(Self, Self) -> Double
pub fn Vector::array(Self) -> Array[Double]
pub fn Vector::copy(Self) -> Self
pub fn Vector::cross(Self, Self) -> Self
pub fn Vector::dist(Self, Self) -> Double
pub fn Vector::div(Self, Double) -> Unit
pub fn Vector::dot(Self, Self) -> Double
pub fn Vector::heading(Self) -> Double
pub fn Vector::lerp(Self, Self, Double) -> Unit
pub fn Vector::limit(Self, Double) -> Unit
pub fn Vector::mag(Self) -> Double
pub fn Vector::mag_sq(Self) -> Double
pub fn Vector::mult(Self, Double) -> Unit
pub fn Vector::new(x? : Double, y? : Double, z? : Double) -> Self
pub fn Vector::normalize(Self) -> Unit
pub fn Vector::rotate(Self, Double) -> Unit
pub fn Vector::set(Self, Double, Double, z? : Double) -> Unit
pub fn Vector::set_mag(Self, Double) -> Unit
pub fn Vector::sub(Self, Self) -> Unit

// Type aliases
pub type ImageFetcher = (String, (Bytes?) -> Unit) -> Unit

// Traits
pub(open) trait ColorArg {
  fn to_color(Self, ColorMode, ColorRanges) -> Color
}
pub impl ColorArg for Int32
pub impl ColorArg for Double
pub impl ColorArg for String
pub impl[A : Num, B : Num] ColorArg for (A, B)
pub impl[A : Num, B : Num, C : Num] ColorArg for (A, B, C)
pub impl[A : Num, B : Num, C : Num, D : Num] ColorArg for (A, B, C, D)

pub(open) trait ImageSource {
  fn image_size(Self) -> (Double, Double)
  fn draw_as_image(Self, Sketch, Double, Double, Double, Double) -> Unit
}

pub(open) trait Num {
  fn to_num(Self) -> Double
}
pub impl Num for Int32
pub impl Num for Double

pub(open) trait Surface {
  fn set_transform(Self, Matrix) -> Unit
  fn save(Self) -> Unit
  fn restore(Self) -> Unit
  fn fill_path(Self, Path, Color) -> Unit
  fn stroke_path(Self, Path, Color, Double, StrokeCap, StrokeJoin) -> Unit
  fn fill_rect(Self, Double, Double, Double, Double, Color) -> Unit
  fn fill_rounded_rect(Self, Double, Double, Double, Double, Double, Color) -> Unit
  fn stroke_rounded_rect(Self, Double, Double, Double, Double, Double, Color, Double) -> Unit
  fn clear_rect(Self, Double, Double, Double, Double) -> Unit
  fn draw_image(Self, Image, Double, Double, Double, Double, Double, Color?) -> Unit
  fn clip_path(Self, Path) -> Unit
  fn clip_end(Self) -> Unit
  fn fill_text(Self, String, Double, Double, Color, Color?, Double, FontSpec, HAlign, VAlign) -> Unit
  fn measure_width(Self, String, FontSpec) -> Double
  fn text_metrics(Self, FontSpec) -> TextMetrics
  fn set_blend_mode(Self, BlendMode) -> Unit
  fn set_smoothing(Self, Bool) -> Unit
}
