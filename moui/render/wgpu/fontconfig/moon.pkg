import {
  "moonbitlang/core/encoding/utf8",
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/render/wgpu" @wgpu_renderer,
  "wzzc-dev/moui/render/wgpu/text_protocol",
}

supported_targets = "native"

options(
  link: {
    "native": {
      "stub-cc-flags": "-I/usr/include/freetype2 -I/usr/include/harfbuzz",
      "cc-link-flags": "-lfontconfig -lharfbuzz -lfreetype -lz",
    },
  },
  "native-stub": [ "linux_fontconfig_text.c" ],
  targets: { },
)
