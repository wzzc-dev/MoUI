import {
  "moonbitlang/core/math",
  "wzzc-dev/moui",
  "wzzc-dev/moui/services",
  "wzzc-dev/moui/views",
  "wzzc-dev/moui_3d",
}

supported_targets = "+native+wasm-gc+wasm"

options(
  "pre-build": [
    {
      "command": ":embed --input $input --output $output --name fixture_gltf",
      "input": "fixture.gltf",
      "output": "fixture_embedded.mbt",
    },
  ],
  targets: { },
)
