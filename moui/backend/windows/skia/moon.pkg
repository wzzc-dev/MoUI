import {
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/moui/backend/platform_bridge",
  "wzzc-dev/moui/backend/windows" @windows_host,
  "wzzc-dev/moui/render",
  "wzzc-dev/moui/render/skia" @skia_renderer,
  "wzzc-dev/moui_skia",
  "wzzc-dev/moui_skia/native" @skia_native,
  "wzzc-dev/window/windows" @win,
}

import {
  "moonbitlang/core/encoding/base64",
  "moonbitlang/x/fs",
  "wzzc-dev/moui/core",
} for "wbtest"

supported_targets = "native"

options(
  link: { "native": { "stub-cc-flags": "${build.MOUI_SKIA_STUB_CC_FLAGS}" } },
  "native-stub": [ "win32_skia_presenter.cpp", "windows_async_image.cpp" ],
  targets: { },
)
