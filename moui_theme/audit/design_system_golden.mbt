      "DesignSemanticPalette.background",
      ThemeMapped,
      "Mapped to MoUI background semantic color.",
    ),
    mapping(
      Material,
      Color,
      SystemToken,
      "--md-sys-color-on-surface",
      source,
      "DesignSemanticPalette.foreground",
