import {
  "moonbitlang/core/buffer",
  "moonbitlang/core/compress/zlib",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string" @strconv,
  "moonbitlang/x/fs",
  "wzzc-dev/moui_cli/scaffold_plan" @plan,
  "wzzc-dev/moui_devtools/socket" @devtools_socket,
}

supported_targets = "+native"

options(
  "allow-experimental-packages": true,
  "native-stub": [ "native_fs.c", "native_process.c" ],
  "pre-build": [
    {
      "input": "moon.mod",
      "output": "version_manifest.mbt",
      "command": ":embed -i $input -o $output --name embedded_module_manifest --text",
    },
  ],
)
