import {
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/moui/backend/platform_bridge",
  "wzzc-dev/moui/backend/internal/embedded_runtime_backend",
  "wzzc-dev/moui/backend/harmonyos" @harmonyos_host,
  "wzzc-dev/moui/render",
  "wzzc-dev/moui/render/skia" @skia_renderer,
  "wzzc-dev/moui_skia",
  "wzzc-dev/moui_skia/native" @skia_native,
}

supported_targets = "native"

options(
  link: {
    "native": {
      "stub-cc-flags": "${build.MOUI_SKIA_STUB_CC_FLAGS}",
      "cc-link-flags": "${build.MOUI_SKIA_CC_LINK_FLAGS}",
    },
  },
  "native-stub": [ "harmonyos_skia_presenter.cpp" ],
  targets: { },
)
