///|
pub(all) struct DesignTokenMapping {
  preset : @common.DesignPreset
  category : DesignTokenCategory
  layer : DesignTokenLayer
  official_token : String
  official_source : String
  moui_token : String
  status : DesignTokenStatus
  note : String
} derive(Eq, Debug, ToJson)

///|
pub(all) struct DesignSourceUsage {
  preset : @common.DesignPreset
  source_label : String
  source_url : String
  source_kind : String
  source_ref : String
  token_path : String
  golden_mapping_count : Int
  source_status : DesignTokenStatus
  status : DesignTokenStatus
  note : String
} derive(Eq, Debug, ToJson)

///|
pub fn golden_mappings(
  preset : @common.DesignPreset,
) -> Array[DesignTokenMapping] {
  match preset {
    Material => material_golden_mappings()
    Carbon => carbon_golden_mappings()
    Primer => primer_golden_mappings()
    Fluent => fluent_golden_mappings()
  }
}

///|
pub fn source_usage(preset : @common.DesignPreset) -> Array[DesignSourceUsage] {
  let usages : Array[DesignSourceUsage] = []
  let mappings = golden_mappings(preset)
  for source in sources(preset) {
    let mut count = 0
    for mapping in mappings {
      if mapping.official_source == source.url {
        count = count + 1
      }
    }
    usages.push(source_usage_entry(preset, source, count))
  }
  usages
}

///|
pub fn undeclared_golden_source_count(preset : @common.DesignPreset) -> Int {
  let mut count = 0
  let sources = sources(preset)
  for mapping in golden_mappings(preset) {
    if !source_url_declared(mapping.official_source, sources) {
      count = count + 1
    }
  }
  count
}

///|
pub fn unused_official_source_count(preset : @common.DesignPreset) -> Int {
  let mut count = 0
  for usage in source_usage(preset) {
    if usage.golden_mapping_count == 0 &&
      (
        usage.source_kind == "official-source" ||
        usage.source_kind == "official-docs"
      ) {
      count = count + 1
    }
  }
  count
}

///|
pub fn has_golden_mapping(
  preset : @common.DesignPreset,
  official_token : String,
) -> Bool {
  golden_mappings(preset).any(item => item.official_token == official_token)
}

///|
pub fn golden_mapped_count(preset : @common.DesignPreset) -> Int {
  let mut count = 0
  for item in golden_mappings(preset) {
    if item.status == ThemeMapped ||
      item.status == ComponentMapped ||
      item.status == OfficialComplete {
      count = count + 1
    }
  }
  count
}

///|
pub fn golden_gap_count(preset : @common.DesignPreset) -> Int {
  let mut count = 0
  for item in golden_mappings(preset) {
    if item.status == NotMapped ||
      item.status == SourceMapped ||
      item.status == PreviewMapped {
      count = count + 1
    }
  }
  count
}

///|
pub fn golden_mapping_for(
  preset : @common.DesignPreset,
  official_token : String,
) -> DesignTokenMapping? {
  for item in golden_mappings(preset) {
    if item.official_token == official_token {
      return Some(item)
    }
  }
  None
}

///|
