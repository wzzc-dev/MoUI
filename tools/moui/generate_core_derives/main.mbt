///|
struct CliOptions {
  repo_root : String
  output : String
  help : Bool
}

///|
fn usage() -> String {
  (
    #|Usage: tools/moui/generate_core_derives [--repo-root PATH] [--output PATH]
    #|
    #|Regenerates moui/core/derives.generated.mbt from the `derive(...)` clauses
    #|and hand-written `pub impl` trait blocks in moui/core/paint.mbt,
    #|moui/core/semantics.mbt, and moui/core/theme.mbt. The generated file
    #|re-exports the derived trait methods across package boundaries with
    #|explicit `pub extend` lines (MoonBit implicit promotion is deprecated).
    #|
    #|The default output is moui/core/derives.generated.mbt under the repo root.
    #|Drift checking is orchestrated by scripts/generate-core-derives.mjs
    #|(--check), which formats the fresh output with moonfmt before comparing.
    #|
  )
}

///|
fn parse_cli(args : Array[String]) -> Result[CliOptions, String] {
  let mut repo_root = "."
  let mut output = ""
  let mut help = false
  let mut index = 0
  while index < args.length() {
    match args[index] {
      "--help" | "-h" => {
        help = true
        index += 1
      }
      "--repo-root" => {
        if index + 1 >= args.length() {
          return Err("missing value for --repo-root")
        }
        repo_root = args[index + 1]
        index += 2
      }
      "--output" => {
        if index + 1 >= args.length() {
          return Err("missing value for --output")
        }
        output = args[index + 1]
        index += 2
      }
      value => return Err("Unknown argument: " + value)
    }
  }
  if output == "" {
    output = @tools.resolve_path(repo_root, "moui/core/derives.generated.mbt")
  }
  Ok({ repo_root, output, help, })
}

///|
fn generated_header() -> String {
  (
    #|// Generated by tools/moui/generate_core_derives. DO NOT EDIT.
    #|//
    #|// Source of truth: the `derive(...)` clauses and hand-written `pub impl`
    #|// trait blocks in moui/core/paint.mbt, moui/core/semantics.mbt, and
    #|// moui/core/theme.mbt. Regenerate with:
    #|//   node scripts/generate-core-derives.mjs
    #|// The lines below re-export derived trait methods across package
    #|// boundaries; MoonBit implicit method promotion is deprecated, so the
    #|// explicit `pub extend` declarations are required.
    #|
  )
}

///|
fn emit_extend_block(entry : TypeDerives) -> Result[String, String] {
  let lines : Array[String] = []
  let seen : Set[String] = Set([])
  for trait_name in canonical_trait_order() {
    let requested = entry.derived.contains(trait_name) ||
      entry.impld.contains(trait_name)
    if !requested {
      continue
    }
    if seen.contains(trait_name) {
      continue
    }
    seen.add(trait_name)
    match extend_method_set(trait_name) {
      Some(methods) => {
        lines.push("///|")
        lines.push("pub extend " + entry.name + " with " + methods)
        lines.push("")
      }
      None => return Err("unmapped trait " + trait_name)
    }
  }
  Ok(lines.join("\n"))
}

///|
fn generate_output(parsed : Array[ParsedSource]) -> Result[String, String] {
  let body = StringBuilder()
  body.write_string(generated_header())
  for source in parsed {
    for entry in source.types {
      if entry.derived.is_empty() && entry.impld.is_empty() {
        continue
      }
      match emit_extend_block(entry) {
        Ok(block) => {
          body.write_string(block)
          body.write_string("\n")
        }
        Err(message) => return Err(message)
      }
    }
  }
  Ok(body.to_string())
}

///|
fn run(args : Array[String]) -> Int32 {
  let options = match parse_cli(args) {
    Ok(value) => value
    Err(message) => {
      println(message)
      println(usage())
      return 2
    }
  }
  if options.help {
    println(usage())
    return 0
  }
  let parsed : Array[ParsedSource] = []
  for file in derive_source_files {
    let path = @tools.resolve_path(options.repo_root, file)
    let text = match @tools.read_required_text(path, file) {
      Ok(value) => value
      Err(message) => {
        println("generate-core-derives: ERROR " + message)
        return 1
      }
    }
    match parse_source(file, text) {
      Ok(parsed_source) => parsed.push(parsed_source)
      Err(message) => {
        println("generate-core-derives: ERROR " + message)
        return 1
      }
    }
  }
  let output = match generate_output(parsed) {
    Ok(value) => value
    Err(message) => {
      println("generate-core-derives: ERROR " + message)
      return 1
    }
  }
  match @tools.write_text_file(options.output, output, options.output) {
    Ok(_) => {
      println("wrote " + options.output)
      0
    }
    Err(message) => {
      println("generate-core-derives: ERROR " + message)
      1
    }
  }
}

///|
fn main {
  let code = run(@tools.args_without_program(@env.args()))
  if code != 0 {
    @sys.exit(code)
  }
}
