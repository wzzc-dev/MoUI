name = "wzzc-dev/moui_markdown"

version = "0.2.3"

preferred_target = "native"

import {
  "wzzc-dev/moui@0.2.5",
  "wzzc-dev/moui_richtext@0.2.3",
}

repository = "https://github.com/wzzc-dev/MoUI.git"

license = "Apache-2.0"

keywords = [ "moui", "markdown", "editor", "addon" ]

description = "Reusable Markdown editing chrome components for MoUI (outline, find/replace, format palette, document info, HTML export)"
