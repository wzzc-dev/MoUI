import {
  "moonbitlang/core/env",
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/render",
  "wzzc-dev/moui/render/skia" @skia_renderer,
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "native-stub": [ "bench_clock.c" ],
  link: { "native": { "cc-link-flags": "" } },
  targets: { "main.mbt": [ "native" ] },
)
