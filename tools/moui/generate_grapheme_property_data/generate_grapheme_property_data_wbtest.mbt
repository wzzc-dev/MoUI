///|
test "parses single and ranged codepoints" {
  match parse_range("000D", "src.txt", 1) {
    Ok(range) => {
      debug_inspect(range.start, content="13")
      debug_inspect(range.end, content="13")
    }
    Err(message) => fail(message)
  }
  match parse_range("0000..0009", "src.txt", 2) {
    Ok(range) => {
      debug_inspect(range.start, content="0")
      debug_inspect(range.end, content="9")
    }
    Err(message) => fail(message)
  }
}

///|
test "merges adjacent ranges" {
  let merged = merge_ranges([
    { start: 1, end: 2 },
    { start: 3, end: 5 },
    { start: 10, end: 10 },
  ])
  debug_inspect(merged.length(), content="2")
  debug_inspect(merged[0].start, content="1")
  debug_inspect(merged[0].end, content="5")
  debug_inspect(merged[1].start, content="10")
}

///|
test "moon hex pads to at least 4 digits" {
  debug_inspect(moon_hex(13), content="\"0x000D\"")
  debug_inspect(moon_hex(0x10FFFF), content="\"0x10FFFF\"")
}

///|
test "generates property predicates from sample UCD snippets" {
  let grapheme =
    #|000D          ; CR # Cc       <control-000D>
    #|000A          ; LF # Cc       <control-000A>
    #|0000..0009    ; Control # Cc  [10] <control-0000>..<control-0009>
    #|
  let emoji =
    #|1F600         ; Extended_Pictographic# E1.0   [1] (😀)       grinning face
    #|
  let derived =
    #|094D          ; InCB; Linker # Mn       DEVANAGARI SIGN VIRAMA
    #|0915          ; InCB; Consonant # Lo       DEVANAGARI LETTER KA
    #|0300          ; InCB; Extend # Mn       COMBINING GRAVE ACCENT
    #|
  match
    generate_from_sources(
      grapheme, "gbp.txt", emoji, "emoji.txt", derived, "dcp.txt",
    ) {
    Ok(text) => {
      debug_inspect(
        text.contains(
          "Generated by scripts/generate-grapheme-property-data.mjs.",
        ),
        content="true",
      )
      debug_inspect(
        text.contains("fn unicode_grapheme_is_cr_17_0"),
        content="true",
      )
      debug_inspect(text.contains("codepoint == 0x000D"), content="true")
      debug_inspect(
        text.contains("fn unicode_emoji_is_extended_pictographic_17_0"),
        content="true",
      )
      debug_inspect(
        text.contains("fn unicode_indic_conjunct_is_linker_17_0"),
        content="true",
      )
    }
    Err(message) => fail(message)
  }
}
