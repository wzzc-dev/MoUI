import {
  "moonbitlang/core/encoding/utf8",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/moui/backend/linux" @linux_host,
  "wzzc-dev/moui/render",
  "wzzc-dev/moui/render/skia" @skia_renderer,
  "wzzc-dev/window/linux" @window_linux,
}

import {
  "moonbitlang/core/encoding/base64",
  "moonbitlang/x/fs",
  "wzzc-dev/moui/core",
} for "wbtest"

supported_targets = "native"

options(
  link: {
    "native": {
      "stub-cc-flags": "${build.MOUI_SKIA_STUB_CC_FLAGS}",
      "cc-link-flags": "-lz -lpthread",
    },
  },
  "native-stub": [ "linux_async_image.cpp" ],
  targets: { },
)
