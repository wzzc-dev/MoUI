import {
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/moui/backend/linux" @linux_host,
  "wzzc-dev/moui/render",
  "wzzc-dev/moui/render/wgpu" @wgpu_renderer,
  "wzzc-dev/moui/render/wgpu/fontconfig" @wgpu_fontconfig,
  "wzzc-dev/moui/render/wgpu/cosmic_text" @wgpu_cosmic_text,
  "Milky2018/wgpu_mbt",
  "Milky2018/wgpu_mbt/c" @wgpu_c,
  "wzzc-dev/window/linux" @window_linux,
}

supported_targets = "native"

options(
  link: { "native": { "cc-link-flags": "-lz" } },
  "native-stub": [ "linux_wgpu_surface_host.c" ],
  targets: { },
)
