// Errors

// Types and methods
pub(all) struct MarkdownBlock {
  kind : MarkdownBlockKind
  text : String
  inlines : Array[MarkdownInline]
  table_alignments : Array[@core.TextAlign?]
  code_language : String?
} derive(Eq, ToJson, @debug.Debug)

pub(all) enum MarkdownBlockKind {
  Heading(Int)
  Paragraph
  UnorderedListItem
  TaskListItem(Bool)
  OrderedListItem(Int)
  Blockquote
  CodeBlock
  HorizontalRule
  Table
  FootnoteDefinition(String)
  HtmlBlock
  FrontMatter
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct MarkdownCodeFenceInfo {
  marker : String
  info : String?
} derive(Eq, @debug.Debug)

pub(all) struct MarkdownEditorAutolinkTarget {
  leading : String
  target : String
  trailing : String
} derive(Eq, @debug.Debug)

pub(all) struct MarkdownEditorBlock {
  block : MarkdownBlock
  source_range : MarkdownSourceRange
  content_range : MarkdownSourceRange
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct MarkdownEditorBlockGroup {
  start_index : Int
  end_index : Int
  source_start : Int
  source_end : Int
}

pub(all) struct MarkdownEditorBlockPosition {
  block : MarkdownEditorBlock
  index : Int
}

pub(all) enum MarkdownEditorCommand {
  Bold
  Italic
  Code
  Strikethrough
  Link
  Image
  SetLinkTarget(String)
  SetImageTarget(String)
  SetCodeLanguage(String)
  SetFootnoteText(String)
  SetHtmlBlockText(String)
  Paragraph
  Heading(Int)
  BulletList
  TaskList
  OrderedList
  Quote
  CodeBlock
  HorizontalRule
  Table
  InsertTableOfContents
  InsertFrontMatter
  DuplicateBlock
  MoveBlockUp
  MoveBlockDown
  InsertTableRow
  InsertTableColumn
  DeleteTableRow
  DeleteTableColumn
  SetTableColumnAlignment(@core.TextAlign?)
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct MarkdownEditorEditResult {
  source : String
  caret : Int
  selection : @core.TextRange?
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct MarkdownEditorFootnoteDefinitionEdit {
  source : String
  anchor_delta : Int
}

pub(all) struct MarkdownEditorFrontMatterMetadata {
  title : String
  tags : Array[String]
}

pub(all) struct MarkdownEditorFrontMatterParseResult {
