# API key (OpenSeek / DeepSeek client). Either variable works.
OPENAI_API_KEY=your-api-key-here
# DEEPSEEK=your-deepseek-key

# OpenAI-compatible API base (Mo Workbench appends /chat/completions for OpenSeek).
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Optional agent workspace + session store (defaults: . and ./.openseek)
# MO_WORKBENCH_WORKSPACE=.
# MO_WORKBENCH_SESSION_ROOT=./.openseek