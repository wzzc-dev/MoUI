///|
pub(all) struct DesignTokenMapping {
  preset : DesignPreset
  category : DesignTokenCategory
  layer : DesignTokenLayer
  official_token : String
  official_source : String
  moui_token : String
  status : DesignTokenStatus
  note : String
} derive(Eq, Debug, ToJson)

///|
pub(all) struct DesignSourceUsage {
  preset : DesignPreset
  source_label : String
  source_url : String
  source_kind : String
  source_ref : String
  token_path : String
  golden_mapping_count : Int
  source_status : DesignTokenStatus
  status : DesignTokenStatus
  note : String
} derive(Eq, Debug, ToJson)

///|
pub fn DesignPreset::golden_mappings(
  self : DesignPreset,
) -> Array[DesignTokenMapping] {
  match self {
    Material => material_golden_mappings()
    Carbon => carbon_golden_mappings()
    Primer => primer_golden_mappings()
    Fluent => fluent_golden_mappings()
  }
}

///|
pub fn DesignPreset::source_usage(
  self : DesignPreset,
) -> Array[DesignSourceUsage] {
  let usages : Array[DesignSourceUsage] = []
  let mappings = self.golden_mappings()
  for source in self.sources() {
    let mut count = 0
    for mapping in mappings {
      if mapping.official_source == source.url {
        count = count + 1
      }
    }
    usages.push(source_usage(self, source, count))
  }
  usages
}

///|
pub fn DesignPreset::undeclared_golden_source_count(self : DesignPreset) -> Int {
  let mut count = 0
  let sources = self.sources()
  for mapping in self.golden_mappings() {
    if !source_url_declared(mapping.official_source, sources) {
      count = count + 1
    }
  }
  count
}

///|
pub fn DesignPreset::unused_official_source_count(self : DesignPreset) -> Int {
  let mut count = 0
  for usage in self.source_usage() {
    if usage.golden_mapping_count == 0 &&
      (
        usage.source_kind == "official-source" ||
        usage.source_kind == "official-docs"
      ) {
      count = count + 1
    }
  }
  count
}

///|
pub fn DesignPreset::has_golden_mapping(
  self : DesignPreset,
  official_token : String,
) -> Bool {
  self.golden_mappings().any(item => item.official_token == official_token)
}

///|
pub fn DesignPreset::golden_mapped_count(self : DesignPreset) -> Int {
  let mut count = 0
  for item in self.golden_mappings() {
    if item.status == DesignTokenStatus::ThemeMapped ||
      item.status == DesignTokenStatus::ComponentMapped ||
      item.status == DesignTokenStatus::OfficialComplete {
      count = count + 1
    }
  }
  count
}

///|
pub fn DesignPreset::golden_gap_count(self : DesignPreset) -> Int {
  let mut count = 0
  for item in self.golden_mappings() {
    if item.status == DesignTokenStatus::NotMapped ||
      item.status == DesignTokenStatus::SourceMapped ||
      item.status == DesignTokenStatus::PreviewMapped {
      count = count + 1
    }
  }
  count
}

///|
pub fn DesignPreset::golden_mapping_for(
  self : DesignPreset,
  official_token : String,
) -> DesignTokenMapping? {
  for item in self.golden_mappings() {
    if item.official_token == official_token {
      return Some(item)
    }
  }
  None
}

