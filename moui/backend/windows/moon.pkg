import {
  "moonbitlang/core/encoding/utf8",
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/moui/render",
  "wzzc-dev/moui/render/wgpu" @wgpu_renderer,
  "wzzc-dev/moui/render/wgpu/cosmic_text" @wgpu_cosmic_text,
  "wzzc-dev/moui/render/wgpu/directwrite" @wgpu_directwrite,
  "Milky2018/wgpu_mbt" @wgpu,
  "Milky2018/wgpu_mbt/c" @wgpu_c,
  "wzzc-dev/window/core" @window_core,
  "wzzc-dev/window/dpi",
  "wzzc-dev/window/windows" @win,
}

supported_targets = "native"

options(
  link: {
    "native": {
      "cc-link-flags": "-lcomdlg32 -lshell32 -ladvapi32 -lole32 -luser32",
    },
  },
  "native-stub": [ "win32_surface_host.c" ],
  targets: { },
)
