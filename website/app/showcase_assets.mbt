///|
/// Generated by scripts/gen-website-showcase-assets.mjs.
/// Do not edit by hand. Optimized WebP previews are copied
/// from resource/screenshots/website into website/web_wasm/assets/screenshots.

///|
fn showcase_image_source(slug : String) -> String {
  match slug {
    "android-componentgallery" =>
      "assets/screenshots/android-componentgallery.webp"
    "excel" => "assets/screenshots/excel.webp"
    "harmonyos-componentgallery" =>
      "assets/screenshots/harmonyos-componentgallery.webp"
    "ios-componentgallery" => "assets/screenshots/ios-componentgallery.webp"
    "markdown_editor" => "assets/screenshots/markdown_editor.webp"
    "mo_workbench" => "assets/screenshots/mo_workbench.webp"
    "showcase" => "assets/screenshots/showcase.webp"
    "webview" => "assets/screenshots/webview.webp"
    _ => ""
  }
}
