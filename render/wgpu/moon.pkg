import {
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/render" @render,
  "Milky2018/wgpu_mbt" @wgpu_mbt,
  "bikallem/freetype" @freetype,
  "bikallem/freetype/base" @ft_base,
  "bikallem/freetype/types" @ft_types,
  "moonbit-community/harfbuzz/face" @hb_face,
  "moonbit-community/harfbuzz/font" @hb_font,
  "moonbit-community/harfbuzz/buffer" @hb_buffer,
  "moonbit-community/harfbuzz/shape" @hb_shape,
  "moonbitlang/x/fs" @fs,
}

supported_targets = "native"

options(
  link: {
    "native": { "cc-link-flags": "-framework AppKit -framework QuartzCore" },
  },
  targets: { },
)
