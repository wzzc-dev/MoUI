name = "mizchi/image"

version = "0.4.2"

import {
  "mizchi/zlib@0.4.6",
}

readme = "README.mbt.md"

repository = "https://github.com/mizchi/image-mbt"

license = "Apache-2.0"

keywords = [
  "moonbit",
  "image",
  "bmp",
  "jpeg",
  "gif",
  "png",
  "webp",
  "ico",
  "avif",
  "encoder",
  "decoder",
]

description = "Image codec primitives for MoonBit with PNG/BMP/JPEG decode+encode, GIF/WebP/ICO/AVIF encode, and resize."

source = "src"

warnings = "-deprecated"
