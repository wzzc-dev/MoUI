///|
let lucide_icon_table : Map[String, String] = {
  let table : Map[String, String] = Map([])
  for line in lucide_icon_table_data.split("\n") {
    let fields = line.split("\t").to_array()
    if fields.length() == 2 {
      table.set(fields[0].to_owned(), fields[1].to_owned())
    }
  }
  table
}

///|
/// Path `d` data for a Lucide icon name, or `None` when the vendored
/// subset does not carry it.
pub fn lucide_icon_path_data(name : String) -> String? {
  lucide_icon_table.get(name)
}

