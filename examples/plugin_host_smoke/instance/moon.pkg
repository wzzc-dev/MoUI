import {
  "wzzc-dev/moui",
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/runtime",
  "examples/plugin_host_smoke/app",
}

supported_targets = "wasm-gc"

pkgtype(kind: "executable")

options(
  link: {
    "wasm-gc": {
      "exports": [ "plugin_init", "plugin_handle_event", "plugin_render" ],
    },
  },
  targets: { "main.mbt": [ "wasm-gc" ] },
)
