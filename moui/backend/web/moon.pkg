import {
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/services",
  "wzzc-dev/moui/backend" @host,
  "wzzc-dev/moui/backend/common" @window_host,
  "wzzc-dev/moui/backend/common/lifecycle" @window_lifecycle,
  "wzzc-dev/moui/backend/common/frame" @window_frame,
  "wzzc-dev/moui/backend/common/image" @window_image,
  "wzzc-dev/moui/backend/common/input" @window_input,
  "wzzc-dev/moui/backend/common/services" @window_services,
  "wzzc-dev/moui/render",
  "wzzc-dev/moui/render/common" @render_common,
  "wzzc-dev/window/core" @window_core,
  "wzzc-dev/window/dpi",
  "wzzc-dev/window/web" @window_web,
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/json",
}

import {
  "wzzc-dev/moui/views",
} for "test"

import {
  "wzzc-dev/moui/views",
} for "wbtest"

supported_targets = "wasm-gc"

options(
  link: {
    "wasm-gc": {
      "exports": [
        "web_dispatch_event",
        "web_dispatch_pointer_input",
        "web_dispatch_route",
        "web_dispatch_semantics_action",
        "web_dispatch_platform_view_event",
        "web_complete_async_clipboard_read",
        "web_complete_async_clipboard_read_image",
        "web_complete_async_file_dialog",
        "web_complete_async_text_file_read",
      ],
    },
  },
  targets: { },
)
