}

///|
fn mapping(
  preset : DesignPreset,
  category : DesignTokenCategory,
  layer : DesignTokenLayer,
  official_token : String,
  official_source : String,
  moui_token : String,
  status : DesignTokenStatus,
  note : String,
) -> DesignTokenMapping {
  {
    preset,
    category,
    layer,
    official_token,
    official_source,
    moui_token,
    status,
    note,
  }
}

///|
fn source_usage(
  preset : DesignPreset,
  source : DesignSystemSource,
  count : Int,
) -> DesignSourceUsage {
  let status = if count > 0 {
    if source.source_kind == "internal-token-contract" ||
      source.source_kind == "internal-component-adapter" {
      DesignTokenStatus::ThemeMapped
    } else {
      DesignTokenStatus::SourceMapped
    }
  } else {
    DesignTokenStatus::NotMapped
  }
  {
    preset,
    source_label: source.label,
    source_url: source.url,
    source_kind: source.source_kind,
    source_ref: source.source_ref,
    token_path: source.token_path,
    golden_mapping_count: count,
    source_status: source.status,
    status,
    note: if count > 0 {
      count.to_string() + " golden mappings cite this source."
    } else {
      "No golden mappings cite this source yet."
    },
  }
}

///|
fn source_url_declared(
  url : String,
  sources : Array[DesignSystemSource],
) -> Bool {
  sources.any(source => source.url == url)
}
