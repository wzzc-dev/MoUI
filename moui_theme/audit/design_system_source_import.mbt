    imported_token(
      @common.DesignPreset::Material,
      DesignTokenCategory::Surface,
      DesignTokenLayer::ReferenceToken,
      "md-ref-palette.neutral98",
      source,
      source_ref,
      "tokens",
      "tokens/versions/v0_192/_md-ref-palette.scss",
      "tokens/versions/v0_192/_md-ref-palette.scss",
      "f2d0f8ff5fcee619ac32d37a5c55f2502c6578ca",
      "'neutral98': if($exclude-hardcoded-values, null, #fef7ff)",
      "@common.DesignSemanticPalette.background",
      DesignTokenStatus::ThemeMapped,
      "Pinned Material Web reference palette resolves the neutral98 value used by the light background system token.",
      official_token="--md-sys-color-background",
    ),
    imported_token(
      @common.DesignPreset::Material,
