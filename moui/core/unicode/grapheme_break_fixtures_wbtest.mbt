    "GB6/GB7/GB8 extended Hangul Jamo sequence",
  )
  assert_generated_grapheme_break_fixture(
    "\u{AC00}\u{11A8}\u{41}",
    [0, 2, 3],
    "GB8 Hangul LV x T",
  )
  assert_generated_grapheme_break_fixture(
    "\u{915}\u{94D}\u{200D}\u{937}",
