import {
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/views",
  "wzzc-dev/moui/render/wgpu" @wgpu_renderer,
  "wzzc-dev/moui/render/skia" @skia_renderer,
  "wzzc-dev/moui_skia/native" @skia_native,
  "wzzc-dev/moui/render/wgpu/cosmic_text",
  "wzzc-dev/moui/render/wgpu/directwrite",
  "wzzc-dev/moui/render/wgpu/fontconfig",
} for "test"

supported_targets = "native"

options(
  link: { "native": { "cc-link-flags": "-lz" } },
  targets: { },
)
