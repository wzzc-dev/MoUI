pub fn ViewSpec::foreground(Self, Color) -> Self
pub fn ViewSpec::frame(Self, width? : Double, height? : Double, min_width? : Double, min_height? : Double, max_width? : Double, max_height? : Double) -> Self
pub fn ViewSpec::key(Self, String) -> Self
pub fn ViewSpec::kind(Self) -> Int
