///|
test "parses unicode grapheme break sample line" {
  match parse_fixture_line("÷ 0020 × 0308 ÷", 1, "sample.txt") {
    Ok(Some(sample)) => {
      debug_inspect(sample.codepoints, content="[32, 776]")
      debug_inspect(sample.boundaries, content="[0, 2]")
    }
    Ok(None) => fail("expected sample")
    Err(message) => fail(message)
  }
}

///|
test "rejects codepoint without boundary marker" {
  match parse_fixture_line("0020 ÷", 3, "sample.txt") {
    Ok(_) => fail("expected error")
    Err(message) =>
      debug_inspect(
        message.contains("no preceding boundary marker"),
        content="true",
      )
  }
}

///|
test "utf8 offsets match multi-byte codepoints" {
  // U+00A9 is 2 utf8 bytes, U+1F600 is 4
  let offsets = utf8_offsets_for_boundaries([0xA9, 0x1F600], [0, 1, 2])
  debug_inspect(offsets, content="[0, 2, 6]")
}

///|
test "escape moon string uses hex codepoints" {
  debug_inspect(escape_moon_string([0x20, 0x308]), content="\"\\\\u{20}\\\\u{308}\"")
}

///|
test "generates core-boundaries fixture header and helper" {
  let sample = {
    line_number: 1,
    codepoints: [0x20],
    boundaries: [0, 1],
    comment: "space",
  }
  match generate_fixture(
    "core-boundaries",
    "samples.txt",
    "assert_generated_grapheme_break_fixture",
    "generated grapheme break fixture samples",
    [sample],
  ) {
    Ok(text) => {
      debug_inspect(
        text.contains("Generated by scripts/generate-grapheme-break-fixtures.mjs."),
        content="true",
      )
      debug_inspect(text.contains("Source fixture: samples.txt"), content="true")
      debug_inspect(
        text.contains("fn assert_generated_grapheme_break_fixture("),
        content="true",
      )
      debug_inspect(
        text.contains("test \"generated grapheme break fixture samples\""),
        content="true",
      )
    }
    Err(message) => fail(message)
  }
}
