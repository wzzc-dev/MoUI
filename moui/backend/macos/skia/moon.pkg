import {
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/host",
  "wzzc-dev/moui/backend/macos" @macos_host,
  "wzzc-dev/moui/render",
  "wzzc-dev/moui/render/skia" @skia_renderer,
  "wzzc-dev/window/macos" @window_macos,
}

import {
  "wzzc-dev/moui/core",
} for "wbtest"

supported_targets = "native"

options(
  link: {
    "native": {
      "cc-link-flags": "-framework AppKit -framework QuartzCore -framework UniformTypeIdentifiers -framework WebKit -framework CoreGraphics -framework CoreFoundation -lz",
    },
  },
  "native-stub": [ "macos_skia_presenter.m" ],
  targets: { },
)
