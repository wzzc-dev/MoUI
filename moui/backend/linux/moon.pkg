import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/render",
  "wzzc-dev/moui/render/common" @render_common,
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/services",
  "wzzc-dev/moui/backend" @host,
  "wzzc-dev/moui/backend/accesskit" @accesskit_bridge,
  "wzzc-dev/moui/backend/common" @window_host,
  "wzzc-dev/moui/backend/common/lifecycle" @window_lifecycle,
  "wzzc-dev/moui/backend/common/frame" @window_frame,
  "wzzc-dev/moui/backend/common/image" @window_image,
  "wzzc-dev/moui/backend/common/input" @window_input,
  "wzzc-dev/moui/backend/common/services" @window_services,
  "wzzc-dev/moui/backend/common/image/native" @host_image_native,
  "wzzc-dev/moui/backend/common/services/native" @host_services_native,
  "wzzc-dev/moui/backend/common/services/desktop" @host_services_desktop,
  "wzzc-dev/window/core" @window_core,
  "wzzc-dev/window/linux" @window_linux,
}

import {
  "wzzc-dev/moui/views",
  "wzzc-dev/window/dpi",
} for "test"

import {
  "wzzc-dev/moui/views",
} for "wbtest"

supported_targets = "native"

options(
  link: {
    "native": { "stub-cc-flags": "${build.MOUI_LINUX_GLIB_STUB_CC_FLAGS}" },
  },
  "native-stub": [
    "linux_service_host.c",
    "linux_timer_host.c",
    "linux_atspi_host.c",
  ],
  targets: { },
)
